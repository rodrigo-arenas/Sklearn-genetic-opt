  "reproduction_script": "import gc\nimport json\nimport platform\nimport sys\nimport time\nfrom unittest.mock import patch\nimport subprocess\nfrom importlib.metadata import version\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.datasets import make_classification, make_regression\nfrom sklearn.linear_model import Ridge\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom sklearn_genetic import GAFeatureSelectionCV\n\n\nimport sklearn_genetic.algorithms as algorithms\n\nbaseline = algorithms._population_diversity\n\n\nimport sklearn_genetic.genetic_search as search_module\n\nstreamed = algorithms.feature_population_diversity\n\n\ndef fit(method, X, y, width, algorithm, seed):\n    regression = width == 256\n    search = GAFeatureSelectionCV(\n        Ridge() if regression else DecisionTreeClassifier(max_depth=3, random_state=seed),\n        population_size=8,\n        generations=2,\n        max_features=min(width // 2, 12),\n        scoring=\"r2\" if regression else \"balanced_accuracy\",\n        cv=3,\n        n_jobs=1,\n        algorithm=algorithm,\n        random_state=seed,\n        error_score=\"raise\",\n        verbose=False,\n    )\n    gc.collect()\n    diversity_ms = []\n    def timed(population):\n        start = time.perf_counter()\n        result = method(population)\n        diversity_ms.append(1000 * (time.perf_counter() - start))\n        return result\n    with patch.object(search_module, \"feature_population_diversity\", timed):\n        start = time.perf_counter()\n        search.fit(X[:120], y[:120])\n        elapsed = 1000 * (time.perf_counter() - start)\n    assert diversity_ms\n    return (elapsed, search.fit_stats_[\"cross_validate_calls\"], sum(diversity_ms), len(diversity_ms)), (\n        np.asarray(search.cv_results_[\"features\"]),\n        search.cv_results_[\"mean_test_score\"],\n        search.support_,\n        *search.history.values(),\n        search.predict(X[120:]),\n    )\n\n\nrecords = []\nwith threadpool_limits(1):\n    for width, algorithm in [\n        (16, \"eaSimple\"),\n        (256, \"eaMuCommaLambda\"),\n        (4096, \"eaMuPlusLambda\"),\n        (4096, \"eaDifferentialEvolution\"),\n    ]:\n        for seed in (3101, 3102, 3103):\n            if width == 256:\n                X, y = make_regression(\n                    n_samples=180, n_features=width, n_informative=8, random_state=seed\n                )\n            else:\n                X, y = make_classification(\n                    n_samples=180,\n                    n_features=width,\n                    n_informative=min(width, 16),\n                    n_redundant=0,\n                    random_state=seed,\n                )\n            if seed == 3101:\n                for cls in (baseline, streamed):\n                    fit(cls, X, y, width, algorithm, seed)\n            reference = None\n            for block, order in enumerate(\n                [(baseline, streamed), (streamed, baseline)]\n            ):\n                pair = {}\n                for cls in order:\n                    stats, outcome = fit(cls, X, y, width, algorithm, seed)\n                    if reference is None:\n                        reference = outcome\n                    else:\n                        for left, right in zip(reference, outcome, strict=True):\n                            np.testing.assert_array_equal(left, right)\n                    pair[\"default\" if cls == baseline else \"optimized\"] = dict(\n                        ms=stats[0], cv_calls=stats[1], diversity_ms=stats[2], diversity_calls=stats[3]\n                    )\n                assert pair[\"default\"][\"cv_calls\"] == pair[\"optimized\"][\"cv_calls\"]\n                records.append(\n                    dict(width=width, algorithm=algorithm, seed=seed, block=block, **pair)\n                )\nprint(\n    json.dumps(\n        dict(\n            checkout=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n            python=platform.python_version(),\n            versions={p: version(p) for p in (\"scikit-learn\", \"numpy\", \"deap\")},\n            records=records,\n            reproduction_script=Path(__file__).read_text(),\n        ),\n        indent=2,\n    )\n)\n",
