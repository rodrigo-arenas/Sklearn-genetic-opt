  "reproduction_script": "\"\"\"Pilot one-standard-error finalist selection on unchanged GA trajectories.\"\"\"\n\nimport json\nimport math\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_diabetes, load_digits, load_wine, make_classification\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import Ridge\nfrom sklearn.metrics import accuracy_score, mean_squared_error\nfrom sklearn.model_selection import KFold, StratifiedKFold, train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GAFeatureSelectionCV\n\n\ntasks = {\n    \"wine-tree\": (load_wine(return_X_y=True), DecisionTreeClassifier(max_depth=6, random_state=0), False),\n    \"digits-knn\": (load_digits(return_X_y=True), make_pipeline(StandardScaler(), KNeighborsClassifier(n_neighbors=5, weights=\"distance\", n_jobs=1)), False),\n    \"diabetes-ridge\": (load_diabetes(return_X_y=True), make_pipeline(StandardScaler(), Ridge(alpha=1)), True),\n    \"synthetic-forest\": (make_classification(n_samples=600, n_features=30, n_informative=9, n_redundant=5, random_state=37), RandomForestClassifier(n_estimators=40, max_depth=8, random_state=0, n_jobs=1), False),\n}\noutput = Path(\".agent-runs/performance-v2/feature-one-se-pilot.jsonl\")\nwith threadpool_limits(limits=1), output.open(\"w\", encoding=\"utf-8\") as stream:\n    for task_name, ((X, y), model, regression) in tasks.items():\n        for seed in range(1051, 1056):\n            train, test = train_test_split(np.arange(len(y)), test_size=0.25, stratify=None if regression else y, random_state=seed)\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            splitter = KFold(3, shuffle=True, random_state=seed) if regression else StratifiedKFold(3, shuffle=True, random_state=seed)\n            folds = list(splitter.split(Xtr, ytr))\n            search = GAFeatureSelectionCV(\n                clone(model), cv=folds, scoring=\"neg_mean_squared_error\" if regression else \"accuracy\",\n                max_features=X.shape[1] // 2, population_size=8, generations=4,\n                random_state=seed, n_jobs=1, verbose=False, error_score=\"raise\",\n            )\n            started = time.perf_counter()\n            search.fit(Xtr, ytr)\n            search_seconds = time.perf_counter() - started\n            results = search.cv_results_\n            means = np.asarray(results[\"mean_test_score\"], dtype=float)\n            deviations = np.asarray(results[\"std_test_score\"], dtype=float)\n            counts = np.asarray(results[\"n_features\"], dtype=int)\n            best_index = max(range(len(means)), key=lambda i: (means[i], -counts[i]))\n            threshold = means[best_index] - deviations[best_index] / math.sqrt(len(folds))\n            eligible = [i for i in range(len(means)) if means[i] >= threshold]\n            selected_index = min(eligible, key=lambda i: (counts[i], -means[i], i))\n            mask = np.asarray(results[\"features\"][selected_index], dtype=bool)\n            one_se_model = clone(model).fit(Xtr[:, mask], ytr)\n            original_predictions = search.best_estimator_.predict(Xte[:, search.support_])\n            selected_predictions = one_se_model.predict(Xte[:, mask])\n            heldout = lambda pred: -mean_squared_error(yte, pred) if regression else accuracy_score(yte, pred)\n            row = dict(\n                task=task_name, seed=seed, search_seconds=search_seconds,\n                candidate_cv_calls=search.fit_stats_[\"cross_validate_calls\"],\n                default_cv=float(max(means)), one_se_cv=float(means[selected_index]),\n                best_cv_standard_error=float(deviations[best_index] / math.sqrt(len(folds))),\n                default_holdout=float(heldout(original_predictions)),\n                one_se_holdout=float(heldout(selected_predictions)),\n                default_features=int(search.support_.sum()), one_se_features=int(mask.sum()),\n                default_mask=np.flatnonzero(search.support_).tolist(),\n                one_se_mask=np.flatnonzero(mask).tolist(),\n            )\n            stream.write(json.dumps(row) + \"\\n\")\n            stream.flush()\n            print(json.dumps(row), flush=True)\n"
