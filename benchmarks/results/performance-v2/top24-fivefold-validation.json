                    if reduced\n                            else np.nanmax(search.cv_results_[\"mean_test_score\"])\n                        ),\n                        candidate_cv_calls=search.fit_stats_[\"cross_validate_calls\"],\n                        final_candidates=(\n                            len(search.final_selection_results_[\"candidates\"]) if reduced else 0\n                        ),\n                        selected_features=(\n                            int(search.support_.sum())\n                            if method == \"features\"\n                            else int(X.shape[1])\n                        ),\n                    )\n                rows.append(row)\n                stream.write(json.dumps(row) + \"\\n\")\n                stream.flush()\n                print(json.dumps(row), flush=True)\n(work / \"top24-fivefold-validation.json\").write_text(\n    json.dumps(rows, indent=2), encoding=\"utf-8\"\n)\n"
