                    estimator = make_pipeline(StandardScaler(), SVC(kernel=\"rbf\"))\n                    study = optuna.create_study(\n                        direction=\"maximize\", sampler=optuna.samplers.TPESampler(seed=seed)\n                    )\n\n                    def objective(trial):\n                        params = {\n                            \"svc__C\": trial.suggest_float(\"svc__C\", 0.01, 100, log=True),\n                            \"svc__gamma\": trial.suggest_float(\n                                \"svc__gamma\", 1e-4, 1, log=True\n                            ),\n                        }\n                        return float(\n                            np.mean(\n                                cross_val_score(\n                                    clone(estimator).set_params(**params),\n                                    Xtr,\n                                    ytr,\n                                    cv=folds,\n                                    scoring=\"accuracy\",\n                                    n_jobs=1,\n                                    error_score=\"raise\",\n                                )\n                            )\n                        )\n\n                    started = time.perf_counter()\n                    study.optimize(objective, n_trials=168, n_jobs=1, show_progress_bar=False)\n                    best = clone(estimator).set_params(**study.best_params).fit(Xtr, ytr)\n                    row = dict(\n                        dataset=dataset,\n                        seed=seed,\n                        method=method,\n                        variant=variant,\n                        seconds=time.perf_counter() - started,\n                        holdout=float(accuracy_score(yte, best.predict(Xte))),\n                        cv_score=float(study.best_value),\n                        candidate_cv_calls=len(study.trials),\n                        final_candidates=0,\n                        selected_features