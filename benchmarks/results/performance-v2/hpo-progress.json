  "reproduction_script": "\"\"\"Measure whether GA hyperparameter-search generations improve on initialization.\"\"\"\n\nimport json\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_breast_cancer, load_digits, make_classification\nfrom sklearn.metrics import accuracy_score\nfrom sklearn.model_selection import StratifiedKFold, train_test_split\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.svm import SVC\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GASearchCV\nfrom sklearn_genetic.space import Continuous\n\n\nwork = Path(\".agent-runs/performance-v2\")\ndatasets = {\n    \"breast\": load_breast_cancer(return_X_y=True),\n    \"digits\": load_digits(return_X_y=True),\n    \"synthetic\": make_classification(\n        n_samples=800, n_features=20, n_informative=8, n_redundant=4, random_state=19\n    ),\n}\nwith threadpool_limits(limits=1), (work / \"hpo-progress.jsonl\").open(\"w\", encoding=\"utf-8\") as stream:\n    for dataset, (X, y) in datasets.items():\n        for seed in range(1001, 1009):\n            train, test = train_test_split(\n                np.arange(len(y)), test_size=0.25, stratify=y, random_state=seed\n            )\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            folds = list(StratifiedKFold(3, shuffle=True, random_state=seed).split(Xtr, ytr))\n            model = make_pipeline(StandardScaler(), SVC(kernel=\"rbf\"))\n            started = time.perf_counter()\n            search = GASearchCV(\n                clone(model),\n                param_grid={\n                    \"svc__C\": Continuous(0.01, 100, distribution=\"log-uniform\"),\n                    \"svc__gamma\": Continuous(1e-4, 1, distribution=\"log-uniform\"),\n                },\n                cv=folds,\n                scoring=\"accuracy\",\n                population_size=8,\n                generations=4,\n                random_state=seed,\n                n_jobs=1,\n                verbose=False,\n                error_score=\"raise\",\n            ).fit(Xtr, ytr)\n            seconds = time.perf_counter() - started\n            scores = np.asarray(search.cv_results_[\"mean_test_score\"], dtype=float)\n            assert len(scores) == 72\n            initial_index = int(np.nanargmax(scores[:8]))\n            initial_params = search.cv_results_[\"params\"][initial_index]\n            initial_model = clone(model).set_params(**initial_params).fit(Xtr, ytr)\n            row = dict(\n                dataset=dataset,\n                seed=seed,\n                seconds=seconds,\n                candidate_cv_calls=search.fit_stats_[\"cross_validate_calls\"],\n                initial_cv=float(scores[initial_index]),\n                final_cv=float(np.nanmax(scores)),\n                initial_holdout=float(accuracy_score(yte, initial_model.predict(Xte))),\n                final_holdout=float(accuracy_score(yte, search.best_estimator_.predict(Xte))),\n                initial_params={key: float(value) for key, value in initial_params.items()},\n                final_params={key: float(value) for key, value in search.best_params_.items()},\n                history_best=[float(np.ravel(value)[0]) for value in search.history[\"fitness_best\"]],\n            )\n            stream.write(json.dumps(row) + \"\\n\")\n            stream.flush()\n            print(json.dumps(row), flush=True)\n",
  "summary_script": "\"\"\"Freeze HPO quality gains from generation zero to generation four.\"\"\"\n\nimport hashlib\nimport importlib.metadata\nimport json\nimport math\nimport platform\nimport statistics\nimport subprocess\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.datasets import load_breast_cancer, load_digits, make_classification\nfrom sklearn.model_selection import StratifiedKFold, train_test_split\n\n\nwork = Path(\".agent-runs/performance-v2\")\nrows = [json.loads(line) for line in (work / \"hpo-progress.jsonl\").read_text(encoding=\"utf-8\").splitlines()]\nexpected = {(dataset, seed) for dataset in (\"breast\", \"digits\", \"synthetic\") for seed in range(1001, 1009)}\nby_key = {(row[\"dataset\"], row[\"seed\"]): row for row in rows}\nassert len(rows) == len(by_key) == len(expected) == 24 and set(by_key) == expected\nfor row in rows:\n    assert 0 < row[\"candidate_cv_calls\"] <= 72\n    assert len(row[\"history_best\"]) == 5\n    assert math.isclose(row[\"initial_cv\"], row[\"history_best\"][0], abs_tol=1e-12)\n    assert math.isclose(row[\"final_cv\"], row[\"history_best\"][-1], abs_tol=1e-12)\n    assert all(left <= right + 1e-12 for left, right in zip(row[\"history_best\"], row[\"history_best\"][1:]))\n    assert 0 <= row[\"initial_holdout\"] <= 1 and 0 <= row[\"final_holdout\"] <= 1\n\nsummary = []\nfor dataset in (\"breast\", \"digits\", \"synthetic\"):\n    subset = [by_key[(dataset, seed)] for seed in range(1001, 1009)]\n    deltas = [row[\"final_holdout\"] - row[\"initial_holdout\"] for row in subset]\n    summary.append(dict(\n        dataset=dataset,\n        initial_cv_mean=statistics.mean(row[\"initial_cv\"] for row in subset),\n        final_cv_mean=statistics.mean(row[\"final_cv\"] for row in subset),\n        cv_delta_mean=statistics.mean(row[\"final_cv\"] - row[\"initial_cv\"] for row in subset),\n        initial_holdout_mean=statistics.mean(row[\"initial_holdout\"] for row in subset),\n        final_holdout_mean=statistics.mean(row[\"final_holdout\"] for row in subset),\n        heldout_delta_mean=statistics.mean(deltas),\n        worst_heldout_delta=min(deltas),\n        heldout_wins=sum(delta > 0 for delta in deltas),\n        heldout_ties=sum(delta == 0 for delta in deltas),\n        heldout_losses=sum(delta < 0 for delta in deltas),\n        cv_improved=sum(row[\"final_cv\"] > row[\"initial_cv\"] for row in subset),\n        generation_best_mean=[statistics.mean(row[\"history_best\"][generation] for row in subset) for generation in range(5)],\n        seconds_mean=statistics.mean(row[\"seconds\"] for row in subset),\n        cv_calls_mean=statistics.mean(row[\"candidate_cv_calls\"] for row in subset),\n    ))\n\ndatasets = {\n    \"breast\": load_breast_cancer(return_X_y=True),\n    \"digits\": load_digits(return_X_y=True),\n    \"synthetic\": make_classification(n_samples=800, n_features=20, n_informative=8, n_redundant=4, random_state=19),\n}\nsplit_sha256 = {}\nfor dataset, (_, y) in datasets.items():\n    for seed in range(1001, 1009):\n        train, test = train_test_split(np.arange(len(y)), test_size=0.25, stratify=y, random_state=seed)\n        folds = list(StratifiedKFold(3, shuffle=True, random_state=seed).split(train, y[train]))\n        arrays = [train, test] + [array for fold in folds for array in fold]\n        split_sha256[f\"{dataset}/{seed}\"] = hashlib.sha256(\n            b\"\".join(np.asarray(array, dtype=\"<i8\").tobytes() for array in arrays)\n        ).hexdigest()\n\nsource_paths = [Path(\"sklearn_genetic/genetic_search.py\"), Path(\"sklearn_genetic/algorithms.py\"), Path(\"sklearn_genetic/population.py\")]\npayload = dict(\n    question=\"Does default HPO evolution improve solutions beyond the initial population?\",\n    source_commit=subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip(),\n    settings=dict(\n        datasets=list(datasets), seeds=list(range(1001, 1009)), holdout_fraction=0.25,\n        cv_folds=3, population_size=8, generations=4, proposal_budget=72,\n        parameter_space={\"svc__C\": \"log-uniform[0.01, 100]\", \"svc__gamma\": \"log-uniform[1e-4, 1]\"},\n        model=\"StandardScaler plus SVC(kernel=rbf)\", cpu_threads=1,\n    ),\n    environment={\"python\": platform.python_version(), **{name: importlib.metadata.version(name) for name in (\"numpy\", \"scikit-learn\", \"scipy\", \"deap\")}},\n    source_sha256={str(path).replace(\"\\\\\", \"/\"): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_paths},\n    split_sha256=split_sha256,\n    raw_sha256=hashlib.sha256(json.dumps(rows, sort_keys=True).encode()).hexdigest(),\n    summary=summary, raw=rows,\n    reproduction_script=(work / \"hpo-progress.py\").read_text(encoding=\"utf-8\"),\n    summary_script=Path(__file__).read_text(encoding=\"utf-8\"),\n)\ndestination = Path(\"benchmarks/results/performance-v2/hpo-progress.json\")\ndestination.write_text(json.dumps(payload, indent=2), encoding=\"utf-8\")\nprint(json.dumps(summary, indent=2))\n"
