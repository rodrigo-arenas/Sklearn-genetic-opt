  "reproduction_script": "\"\"\"Compare GA feature masks with equal-budget random masks across model families.\"\"\"\n\nimport json\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_diabetes, load_digits, load_wine, make_classification\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import Ridge\nfrom sklearn.metrics import accuracy_score, mean_squared_error\nfrom sklearn.model_selection import KFold, StratifiedKFold, cross_val_score, train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GAFeatureSelectionCV\n\n\ntasks = {\n    \"wine-tree\": dict(\n        data=load_wine(return_X_y=True), model=DecisionTreeClassifier(max_depth=6, random_state=0), regression=False,\n    ),\n    \"digits-knn\": dict(\n        data=load_digits(return_X_y=True), model=make_pipeline(StandardScaler(), KNeighborsClassifier(n_neighbors=5, weights=\"distance\", n_jobs=1)), regression=False,\n    ),\n    \"diabetes-ridge\": dict(\n        data=load_diabetes(return_X_y=True), model=make_pipeline(StandardScaler(), Ridge(alpha=1)), regression=True,\n    ),\n    \"synthetic-forest\": dict(\n        data=make_classification(n_samples=600, n_features=30, n_informative=9, n_redundant=5, random_state=37),\n        model=RandomForestClassifier(n_estimators=40, max_depth=8, random_state=0, n_jobs=1), regression=False,\n    ),\n}\noutput = Path(\".agent-runs/performance-v2/feature-random-transfer.jsonl\")\nwith threadpool_limits(limits=1), output.open(\"w\", encoding=\"utf-8\") as stream:\n    for task_name, task in tasks.items():\n        X, y = task[\"data\"]\n        cap = X.shape[1] // 2\n        metric = \"neg_mean_squared_error\" if task[\"regression\"] else \"accuracy\"\n        for seed in range(1041, 1046):\n            train, test = train_test_split(\n                np.arange(len(y)), test_size=0.25, stratify=None if task[\"regression\"] else y,\n                random_state=seed,\n            )\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            splitter = KFold(3, shuffle=True, random_state=seed) if task[\"regression\"] else StratifiedKFold(3, shuffle=True, random_state=seed)\n            folds = list(splitter.split(Xtr, ytr))\n            methods = (\"genetic\", \"random\") if seed % 2 else (\"random\", \"genetic\")\n            for method in methods:\n                started = time.perf_counter()\n                if method == \"genetic\":\n                    search = GAFeatureSelectionCV(\n                        clone(task[\"model\"]), cv=folds, scoring=metric, max_features=cap,\n                        population_size=8, generations=4, random_state=seed,\n                        n_jobs=1, verbose=False, error_score=\"raise\",\n                    ).fit(Xtr, ytr)\n                    mask = search.support_\n                    cv_score = float(np.nanmax(search.cv_results_[\"mean_test_score\"]))\n                    calls = search.fit_stats_[\"cross_validate_calls\"]\n                    proposals = search.fit_stats_[\"evaluated_candidates\"]\n                    fitted = search.best_estimator_\n                else:\n                    rng = np.random.default_rng(seed)\n                    scored = {}\n                    for _ in range(72):\n                        count = int(rng.integers(1, cap + 1))\n                        indices = rng.choice(X.shape[1], count, replace=False)\n                        candidate = np.zeros(X.shape[1], dtype=bool)\n                        candidate[indices] = True\n                        key = tuple(candidate)\n                        if key not in scored:\n                            scored[key] = float(np.mean(cross_val_score(\n                                clone(task[\"model\"]), Xtr[:, candidate], ytr,\n                                cv=folds, scoring=metric, n_jobs=1, error_score=\"raise\",\n                            )))\n                    best_key = max(scored, key=lambda key: (scored[key], -sum(key)))\n                    mask = np.asarray(best_key, dtype=bool)\n                    cv_score = scored[best_key]\n                    calls = len(scored)\n                    proposals = 72\n                    fitted = clone(task[\"model\"]).fit(Xtr[:, mask], ytr)\n                predictions = fitted.predict(Xte[:, mask])\n                holdout = -mean_squared_error(yte, predictions) if task[\"regression\"] else accuracy_score(yte, predictions)\n                row = dict(\n                    task=task_name, seed=seed, method=method,\n                    seconds=time.perf_counter() - started,\n                    cv_score=float(cv_score), holdout=float(holdout),\n                    selected_features=int(mask.sum()), candidate_cv_calls=int(calls),\n                    proposals=int(proposals), mask=np.flatnonzero(mask).tolist(),\n                )\n                stream.write(json.dumps(row) + \"\\n\")\n                stream.flush()\n                print(json.dumps(row), flush=True)\n",
  "summary_script": "\"\"\"Freeze equal-budget GA/random feature-mask comparisons across model families.\"\"\"\n\nimport hashlib\nimport importlib.metadata\nimport json\nimport math\nimport platform\nimport statistics\nimport subprocess\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.datasets import load_diabetes, load_digits, load_wine, make_classification\nfrom sklearn.model_selection import KFold, StratifiedKFold, train_test_split\n\n\nwork = Path(\".agent-runs/performance-v2\")\nrows = [json.loads(line) for line in (work / \"feature-random-transfer.jsonl\").read_text(encoding=\"utf-8\").splitlines()]\ntasks = {\n    \"wine-tree\": (load_wine(return_X_y=True), False),\n    \"digits-knn\": (load_digits(return_X_y=True), False),\n    \"diabetes-ridge\": (load_diabetes(return_X_y=True), True),\n    \"synthetic-forest\": (make_classification(n_samples=600, n_features=30, n_informative=9, n_redundant=5, random_state=37), False),\n}\nexpected = {(task, seed, method) for task in tasks for seed in range(1041, 1046) for method in (\"genetic\", \"random\")}\nby_key = {(row[\"task\"], row[\"seed\"], row[\"method\"]): row for row in rows}\nassert len(rows) == len(by_key) == len(expected) == 40 and set(by_key) == expected\nfor row in rows:\n    width = tasks[row[\"task\"]][0][0].shape[1]\n    assert row[\"proposals\"] == 72\n    assert 0 < row[\"candidate_cv_calls\"] <= 72\n    assert 1 <= row[\"selected_features\"] == len(row[\"mask\"]) <= width // 2\n    assert len(set(row[\"mask\"])) == len(row[\"mask\"])\n    assert all(0 <= index < width for index in row[\"mask\"])\n    assert math.isfinite(row[\"cv_score\"]) and math.isfinite(row[\"holdout\"])\n    assert math.isfinite(row[\"seconds\"]) and row[\"seconds\"] > 0\n\nsummary = []\nfor task in tasks:\n    paired = [(by_key[(task, seed, \"genetic\")], by_key[(task, seed, \"random\")]) for seed in range(1041, 1046)]\n    deltas = [ga[\"holdout\"] - random[\"holdout\"] for ga, random in paired]\n    summary.append(dict(\n        task=task, seeds=list(range(1041, 1046)),\n        ga_cv_mean=statistics.mean(a[\"cv_score\"] for a, _ in paired),\n        random_cv_mean=statistics.mean(b[\"cv_score\"] for _, b in paired),\n        ga_holdout_mean=statistics.mean(a[\"holdout\"] for a, _ in paired),\n        random_holdout_mean=statistics.mean(b[\"holdout\"] for _, b in paired),\n        heldout_delta_mean=statistics.mean(deltas),\n        worst_ga_holdout_delta=min(deltas),\n        ga_wins=sum(delta > 0 for delta in deltas),\n        ties=sum(delta == 0 for delta in deltas),\n        ga_losses=sum(delta < 0 for delta in deltas),\n        ga_seconds_mean=statistics.mean(a[\"seconds\"] for a, _ in paired),\n        random_seconds_mean=statistics.mean(b[\"seconds\"] for _, b in paired),\n        ga_cv_calls_mean=statistics.mean(a[\"candidate_cv_calls\"] for a, _ in paired),\n        random_cv_calls_mean=statistics.mean(b[\"candidate_cv_calls\"] for _, b in paired),\n        ga_selected_mean=statistics.mean(a[\"selected_features\"] for a, _ in paired),\n        random_selected_mean=statistics.mean(b[\"selected_features\"] for _, b in paired),\n    ))\n\nsplit_sha256 = {}\nfor task, ((_, y), regression) in tasks.items():\n    for seed in range(1041, 1046):\n        train, test = train_test_split(np.arange(len(y)), test_size=0.25, stratify=None if regression else y, random_state=seed)\n        splitter = KFold(3, shuffle=True, random_state=seed) if regression else StratifiedKFold(3, shuffle=True, random_state=seed)\n        folds = list(splitter.split(train, y[train]))\n        arrays = [train, test] + [a for fold in folds for a in fold]\n        split_sha256[f\"{task}/{seed}\"] = hashlib.sha256(b\"\".join(np.asarray(a, dtype=\"<i8\").tobytes() for a in arrays)).hexdigest()\n\nsource_paths = [Path(\"sklearn_genetic/genetic_search.py\"), Path(\"sklearn_genetic/algorithms.py\"), Path(\"sklearn_genetic/population.py\")]\npayload = dict(\n    question=\"Does default GA feature selection beat equal-budget random masks across model families?\",\n    source_commit=subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip(),\n    settings=dict(\n        tasks=list(tasks), seeds=list(range(1041, 1046)), holdout_fraction=0.25,\n        cv_folds=3, proposal_budget=72, max_features=\"half\", cpu_threads=1,\n        mask_control=\"Draw cardinality uniformly from 1..cap, then columns uniformly without replacement; cache duplicates; break equal CV scores toward fewer columns.\",\n        order=\"Alternated by seed\",\n    ),\n    environment={\"python\": platform.python_version(), **{name: importlib.metadata.version(name) for name in (\"numpy\", \"scikit-learn\", \"scipy\", \"deap\")}},\n    source_sha256={str(path).replace(\"\\\\\", \"/\"): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_paths},\n    split_sha256=split_sha256,\n    raw_sha256=hashlib.sha256(json.dumps(rows, sort_keys=True).encode()).hexdigest(),\n    summary=summary, raw=rows,\n    reproduction_script=(work / \"feature-random-transfer.py\").read_text(encoding=\"utf-8\"),\n    summary_script=Path(__file__).read_text(encoding=\"utf-8\"),\n)\ndestination = Path(\"benchmarks/results/performance-v2/feature-random-transfer.json\")\ndestination.write_text(json.dumps(payload, indent=2), encoding=\"utf-8\")\nprint(json.dumps(summary, indent=2))\n"
