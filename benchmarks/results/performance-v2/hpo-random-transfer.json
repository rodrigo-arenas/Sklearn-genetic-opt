  "reproduction_script": "\"\"\"Equal-budget HPO GA versus sklearn random search across model families.\"\"\"\n\nimport json\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom scipy.stats import loguniform, uniform\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_diabetes, load_digits, load_wine, make_classification\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import ElasticNet\nfrom sklearn.metrics import accuracy_score, mean_squared_error\nfrom sklearn.model_selection import KFold, RandomizedSearchCV, StratifiedKFold, train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GASearchCV\nfrom sklearn_genetic.space import Categorical, Continuous, Integer\n\n\ntasks = {\n    \"wine-tree\": dict(\n        data=load_wine(return_X_y=True), model=DecisionTreeClassifier(random_state=0),\n        ga_space={\"max_depth\": Integer(2, 15), \"criterion\": Categorical([\"gini\", \"entropy\"])},\n        random_space={\"max_depth\": list(range(2, 16)), \"criterion\": [\"gini\", \"entropy\"]},\n        random_budget=28, regression=False,\n    ),\n    \"digits-knn\": dict(\n        data=load_digits(return_X_y=True),\n        model=make_pipeline(StandardScaler(), KNeighborsClassifier(n_jobs=1)),\n        ga_space={\"kneighborsclassifier__n_neighbors\": Integer(1, 25), \"kneighborsclassifier__weights\": Categorical([\"uniform\", \"distance\"])},\n        random_space={\"kneighborsclassifier__n_neighbors\": list(range(1, 26)), \"kneighborsclassifier__weights\": [\"uniform\", \"distance\"]},\n        random_budget=50, regression=False,\n    ),\n    \"diabetes-elasticnet\": dict(\n        data=load_diabetes(return_X_y=True),\n        model=make_pipeline(StandardScaler(), ElasticNet(max_iter=2000, random_state=0)),\n        ga_space={\"elasticnet__alpha\": Continuous(0.001, 10, distribution=\"log-uniform\"), \"elasticnet__l1_ratio\": Continuous(0.01, 0.99)},\n        random_space={\"elasticnet__alpha\": loguniform(0.001, 10), \"elasticnet__l1_ratio\": uniform(0.01, 0.98)},\n        random_budget=72, regression=True,\n    ),\n    \"synthetic-forest\": dict(\n        data=make_classification(n_samples=600, n_features=20, n_informative=8, n_redundant=4, random_state=29),\n        model=RandomForestClassifier(random_state=0, n_jobs=1),\n        ga_space={\"n_estimators\": Integer(20, 60), \"max_depth\": Integer(2, 12)},\n        random_space={\"n_estimators\": list(range(20, 61)), \"max_depth\": list(range(2, 13))},\n        random_budget=72, regression=False,\n    ),\n}\noutput = Path(\".agent-runs/performance-v2/hpo-random-transfer.jsonl\")\nwith threadpool_limits(limits=1), output.open(\"w\", encoding=\"utf-8\") as stream:\n    for task_name, task in tasks.items():\n        X, y = task[\"data\"]\n        for seed in range(1091, 1096):\n            train, test = train_test_split(\n                np.arange(len(y)), test_size=0.25,\n                stratify=None if task[\"regression\"] else y, random_state=seed,\n            )\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            splitter = KFold(3, shuffle=True, random_state=seed) if task[\"regression\"] else StratifiedKFold(3, shuffle=True, random_state=seed)\n            folds = list(splitter.split(Xtr, ytr))\n            metric = \"neg_mean_squared_error\" if task[\"regression\"] else \"accuracy\"\n            methods = (\"genetic\", \"random\") if seed % 2 else (\"random\", \"genetic\")\n            for method in methods:\n                if method == \"genetic\":\n                    search = GASearchCV(\n                        clone(task[\"model\"]), param_grid=task[\"ga_space\"], cv=folds,\n                        scoring=metric, population_size=8, generations=4,\n                        random_state=seed, n_jobs=1, verbose=False, error_score=\"raise\",\n                    )\n                else:\n                    search = RandomizedSearchCV(\n                        clone(task[\"model\"]), param_distributions=task[\"random_space\"],\n                        n_iter=task[\"random_budget\"], cv=folds, scoring=metric,\n                        random_state=seed, n_jobs=1, error_score=\"raise\",\n                    )\n                started = time.perf_counter()\n                search.fit(Xtr, ytr)\n                seconds = time.perf_counter() - started\n                predictions = search.best_estimator_.predict(Xte)\n                holdout = -mean_squared_error(yte, predictions) if task[\"regression\"] else accuracy_score(yte, predictions)\n                params = {k: v.item() if isinstance(v, np.generic) else v for k, v in search.best_params_.items()}\n                row = dict(\n                    task=task_name, seed=seed, method=method,\n                    seconds=seconds, cv_score=float(search.best_score_),\n                    holdout=float(holdout), params=params,\n                    candidate_cv_calls=int(search.fit_stats_[\"cross_validate_calls\"])\n                    if method == \"genetic\" else len(search.cv_results_[\"params\"]),\n                    proposals=int(search.fit_stats_[\"evaluated_candidates\"])\n                    if method == \"genetic\" else task[\"random_budget\"],\n                )\n                stream.write(json.dumps(row) + \"\\n\")\n                stream.flush()\n                print(task_name, seed, method, f\"holdout={holdout:.6f}\",\n                      f\"seconds={seconds:.3f}\", flush=True)\n"
}
