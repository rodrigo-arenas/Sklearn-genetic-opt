  "reproduction_script": "\"\"\"Post-hoc one-standard-error finalist selection across HPO model families.\"\"\"\n\nimport json\nimport math\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_diabetes, load_digits, load_wine, make_classification\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import ElasticNet\nfrom sklearn.metrics import accuracy_score, mean_squared_error\nfrom sklearn.model_selection import KFold, StratifiedKFold, train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GASearchCV\nfrom sklearn_genetic.space import Categorical, Continuous, Integer\n\n\ntasks = {\n    \"wine-tree\": dict(\n        data=load_wine(return_X_y=True),\n        model=DecisionTreeClassifier(random_state=0),\n        space={\"max_depth\": Integer(2, 15), \"criterion\": Categorical([\"gini\", \"entropy\"])},\n        regression=False,\n    ),\n    \"digits-knn\": dict(\n        data=load_digits(return_X_y=True),\n        model=make_pipeline(StandardScaler(), KNeighborsClassifier(n_jobs=1)),\n        space={\"kneighborsclassifier__n_neighbors\": Integer(1, 25), \"kneighborsclassifier__weights\": Categorical([\"uniform\", \"distance\"])},\n        regression=False,\n    ),\n    \"diabetes-elasticnet\": dict(\n        data=load_diabetes(return_X_y=True),\n        model=make_pipeline(StandardScaler(), ElasticNet(max_iter=2000, random_state=0)),\n        space={\"elasticnet__alpha\": Continuous(0.001, 10, distribution=\"log-uniform\"), \"elasticnet__l1_ratio\": Continuous(0.01, 0.99)},\n        regression=True,\n    ),\n    \"synthetic-forest\": dict(\n        data=make_classification(n_samples=600, n_features=20, n_informative=8, n_redundant=4, random_state=29),\n        model=RandomForestClassifier(random_state=0, n_jobs=1),\n        space={\"n_estimators\": Integer(20, 60), \"max_depth\": Integer(2, 12)},\n        regression=False,\n    ),\n}\noutput = Path(\".agent-runs/performance-v2/hpo-stability-finalist-pilot.jsonl\")\nwith threadpool_limits(limits=1), output.open(\"w\", encoding=\"utf-8\") as stream:\n    for task_name, task in tasks.items():\n        X, y = task[\"data\"]\n        for seed in range(1071, 1076):\n            train, test = train_test_split(\n                np.arange(len(y)), test_size=0.25,\n                stratify=None if task[\"regression\"] else y, random_state=seed,\n            )\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            splitter = KFold(3, shuffle=True, random_state=seed) if task[\"regression\"] else StratifiedKFold(3, shuffle=True, random_state=seed)\n            folds = list(splitter.split(Xtr, ytr))\n            search = GASearchCV(\n                clone(task[\"model\"]), param_grid=task[\"space\"], cv=folds,\n                scoring=\"neg_mean_squared_error\" if task[\"regression\"] else \"accuracy\",\n                population_size=8, generations=4, random_state=seed,\n                n_jobs=1, verbose=False, error_score=\"raise\",\n            )\n            started = time.perf_counter()\n            search.fit(Xtr, ytr)\n            search_seconds = time.perf_counter() - started\n            results = search.cv_results_\n            means = np.asarray(results[\"mean_test_score\"], dtype=float)\n            deviations = np.asarray(results[\"std_test_score\"], dtype=float)\n            finite = np.flatnonzero(np.isfinite(means) & np.isfinite(deviations))\n            best_index = int(search.best_index_)\n            stable_index = int(max(finite, key=lambda i: (means[i] - deviations[i] / math.sqrt(len(folds)), means[i], -i)))\n            stable_model = clone(task[\"model\"]).set_params(**results[\"params\"][stable_index]).fit(Xtr, ytr)\n            default_predictions = search.best_estimator_.predict(Xte)\n            stable_predictions = stable_model.predict(Xte)\n            heldout = lambda pred: -mean_squared_error(yte, pred) if task[\"regression\"] else accuracy_score(yte, pred)\n            row = dict(\n                task=task_name, seed=seed, search_seconds=search_seconds,\n                candidate_cv_calls=search.fit_stats_[\"cross_validate_calls\"],\n                default_cv=float(means[best_index]), stable_cv=float(means[stable_index]),\n                default_cv_std=float(deviations[best_index]), stable_cv_std=float(deviations[stable_index]),\n                default_holdout=float(heldout(default_predictions)),\n                stable_holdout=float(heldout(stable_predictions)),\n                default_index=best_index, stable_index=stable_index,\n                default_params={k: v.item() if isinstance(v, np.generic) else v for k, v in results[\"params\"][best_index].items()},\n                stable_params={k: v.item() if isinstance(v, np.generic) else v for k, v in results[\"params\"][stable_index].items()},\n            )\n            stream.write(json.dumps(row) + \"\\n\")\n            stream.flush()\n            print(task_name, seed, f\"delta={row['stable_holdout'] - row['default_holdout']:.6f}\",\n                  f\"changed={stable_index != best_index}\", flush=True)\n"
}
