  "reproduction_script": "\"\"\"Compare single-bit feature mutation with the current default on new splits.\"\"\"\n\nimport json\nimport random\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_diabetes, load_digits, load_wine, make_classification\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import Ridge\nfrom sklearn.metrics import accuracy_score, mean_squared_error\nfrom sklearn.model_selection import KFold, StratifiedKFold, train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GAFeatureSelectionCV\n\n\nclass SingleBitFeatureSearch(GAFeatureSelectionCV):\n    def mutate(self, individual):\n        individual[random.randrange(len(individual))] ^= 1\n        self._repair_individual(individual)\n        return (individual,)\n\n\ntasks = {\n    \"wine-tree\": (load_wine(return_X_y=True), DecisionTreeClassifier(max_depth=6, random_state=0), False),\n    \"digits-knn\": (load_digits(return_X_y=True), make_pipeline(StandardScaler(), KNeighborsClassifier(n_neighbors=5, weights=\"distance\", n_jobs=1)), False),\n    \"diabetes-ridge\": (load_diabetes(return_X_y=True), make_pipeline(StandardScaler(), Ridge(alpha=1)), True),\n    \"synthetic-forest\": (make_classification(n_samples=600, n_features=30, n_informative=9, n_redundant=5, random_state=37), RandomForestClassifier(n_estimators=40, max_depth=8, random_state=0, n_jobs=1), False),\n}\nmethods = {\n    \"default\": (GAFeatureSelectionCV, 0.1),\n    \"single-bit-0.1\": (SingleBitFeatureSearch, 0.1),\n    \"single-bit-0.8\": (SingleBitFeatureSearch, 0.8),\n}\noutput = Path(\".agent-runs/performance-v2/feature-local-mutation-pilot.jsonl\")\nwith threadpool_limits(limits=1), output.open(\"w\", encoding=\"utf-8\") as stream:\n    for task_name, ((X, y), model, regression) in tasks.items():\n        for seed in range(1061, 1066):\n            train, test = train_test_split(np.arange(len(y)), test_size=0.25, stratify=None if regression else y, random_state=seed)\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            splitter = KFold(3, shuffle=True, random_state=seed) if regression else StratifiedKFold(3, shuffle=True, random_state=seed)\n            folds = list(splitter.split(Xtr, ytr))\n            method_order = list(methods)\n            method_order = method_order[seed % len(method_order):] + method_order[:seed % len(method_order)]\n            for method in method_order:\n                cls, mutation_probability = methods[method]\n                search = cls(\n                    clone(model), cv=folds, scoring=\"neg_mean_squared_error\" if regression else \"accuracy\",\n                    max_features=X.shape[1] // 2, population_size=8, generations=4,\n                    random_state=seed, n_jobs=1, verbose=False, error_score=\"raise\",\n                    mutation_probability=mutation_probability,\n                )\n                started = time.perf_counter()\n                search.fit(Xtr, ytr)\n                seconds = time.perf_counter() - started\n                mask = np.asarray(search.support_, dtype=bool)\n                predictions = search.best_estimator_.predict(Xte[:, mask])\n                holdout = -mean_squared_error(yte, predictions) if regression else accuracy_score(yte, predictions)\n                row = dict(task=task_name, seed=seed, method=method, seconds=seconds,\n                           cv_score=float(max(search.cv_results_[\"mean_test_score\"])),\n                           holdout=float(holdout), n_features=int(mask.sum()),\n                           mask=np.flatnonzero(mask).tolist(),\n                           candidate_cv_calls=search.fit_stats_[\"cross_validate_calls\"])\n                stream.write(json.dumps(row) + \"\\n\")\n                stream.flush()\n                print(task_name, seed, method, f\"holdout={holdout:.6f}\", f\"seconds={seconds:.3f}\", flush=True)\n"
}
