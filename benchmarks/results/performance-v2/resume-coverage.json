  "reproduction_script": "import json\nimport platform\nimport subprocess\nimport sys\nfrom importlib.metadata import version\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\n\nfrom sklearn.datasets import make_classification\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom sklearn_genetic import GAFeatureSelectionCV, GASearchCV\nfrom sklearn_genetic.callbacks import ModelCheckpoint\nfrom sklearn_genetic.space import Integer\n\n\ndef fit(kind, seed, generations, X, y, path):\n    opts = dict(\n        estimator=DecisionTreeClassifier(random_state=seed), cv=3,\n        scoring=\"accuracy\", population_size=6, generations=generations,\n        n_jobs=1, verbose=False, error_score=\"raise\", random_state=seed,\n    )\n    if kind == \"features\":\n        search = GAFeatureSelectionCV(max_features=6, **opts)\n    else:\n        search = GASearchCV(param_grid={\n            \"max_depth\": Integer(2, 20), \"min_samples_leaf\": Integer(1, 16),\n        }, **opts)\n    checkpoint = ModelCheckpoint(path)\n    search.fit(X[:144], y[:144], callbacks=[checkpoint])\n    saved = checkpoint.load()[\"runtime_state\"]\n    keys = set(saved[\"fitness_cache\"])\n    stats = saved[\"fit_stats_\"]\n    assert stats[\"cross_validate_calls\"] == len(keys)\n    return dict(\n        evaluated=stats[\"evaluated_candidates\"], distinct=len(keys),\n        cv_calls=stats[\"cross_validate_calls\"], cache_hits=stats[\"cache_hits\"],\n        last_generation=search.history[\"gen\"][-1], best_cv=max(search.cv_results_[\"mean_test_score\"]),\n        holdout_accuracy=float((search.predict(X[144:]) == y[144:]).mean()),\n    ), keys\n\n\nrecords = []\nwith threadpool_limits(1), TemporaryDirectory() as folder:\n    for seed in (2701, 2702, 2703, 2704):\n        X, y = make_classification(n_samples=216, n_features=24, n_informative=8,\n                                   n_redundant=4, random_state=seed)\n        for kind in (\"hyperparameters\", \"features\"):\n            base = Path(folder) / f\"{kind}-{seed}\"\n            previous = set()\n            segments = []\n            for i in range(3):\n                stats, keys = fit(kind, seed, 1, X, y, base.with_suffix(\".pkl\"))\n                assert previous <= keys\n                stats[\"additional_distinct\"] = len(keys - previous)\n                segments.append(stats)\n                previous = keys\n            reference, full_keys = fit(kind, seed, 3, X, y, base.with_suffix(\".continuous\"))\n            records.append(dict(kind=kind, seed=seed, segments=segments, continuous=reference,\n                                common_distinct=len(previous & full_keys)))\nprint(json.dumps(dict(\n    checkout=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n    python=platform.python_version(), versions={p: version(p) for p in\n    (\"scikit-learn\",\"numpy\",\"deap\")}, records=records, reproduction_script=Path(__file__).read_text()\n),indent=2))\n\n"
}
