  "reproduction_script": "\"\"\"Run from the repository root with the package installed editable.\"\"\"\nimport json\nimport platform\nimport random\nimport subprocess\nimport sys\nfrom importlib.metadata import version\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.metrics import get_scorer\nfrom sklearn.model_selection import cross_val_score, train_test_split\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom benchmarks.benchmark_fit import SCENARIOS, make_cv\nfrom sklearn_genetic import GASearchCV, GAFeatureSelectionCV\n\n\ndef paired_run(task, seed, features):\n    sc = SCENARIOS[task]\n    X, y = sc.loader()\n    Xtr, Xte, ytr, yte = train_test_split(\n        X, y, test_size=.25, random_state=seed,\n        stratify=y if sc.task == \"classification\" else None,\n    )\n    folds = list(make_cv(sc, 3, seed).split(Xtr, ytr))\n    model = sc.estimator_builder(seed)\n    space = sc.param_grid_builder()\n    columns = X.shape[1]\n    limit = columns // 2\n    options = dict(cv=folds, scoring=sc.scoring, population_size=6, generations=2,\n                   n_jobs=1, random_state=seed, error_score=\"raise\", verbose=False)\n    if features:\n        search = GAFeatureSelectionCV(model, max_features=limit, **options)\n    else:\n        search = GASearchCV(model, param_grid=space, **options)\n    search.fit(Xtr, ytr)\n    results = search.cv_results_\n    candidates = results[\"features\" if features else \"params\"]\n    archive = {}\n    for candidate, score in zip(candidates, results[\"mean_test_score\"]):\n        key = tuple(map(bool, candidate)) if features else tuple(sorted(candidate.items()))\n        archive.setdefault(key, float(score))\n    assert len(archive) == search.fit_stats_[\"cross_validate_calls\"]\n    initial = dict(list(archive.items())[:6])\n    assert len(set(tuple(map(bool,c)) if features else tuple(sorted(c.items()))\n                   for c in candidates[:6])) == len(initial) == 6\n    assert max(initial.values()) == search.history[\"fitness_best\"][0]\n\n    def prepare(key, data):\n        if features:\n            return clone(model), data[:, np.asarray(key)]\n        return clone(model).set_params(**dict(key)), data\n\n    control = initial.copy()\n    random.seed(seed + 10000)\n    np.random.seed(seed + 10000)\n    while len(control) < len(archive):\n        if features:\n            selected = set(random.sample(range(columns), random.randint(1, limit)))\n            key = tuple(i in selected for i in range(columns))\n        else:\n            key = tuple(sorted((name, dim.sample()) for name, dim in space.items()))\n        if key in control:\n            continue\n        est, data = prepare(key, Xtr)\n        control[key] = float(cross_val_score(est, data, ytr, cv=folds, scoring=sc.scoring,\n                                            n_jobs=1, error_score=\"raise\").mean())\n\n    def incumbent(pool):\n        best = max(pool, key=pool.get)\n        est, train = prepare(best, Xtr)\n        _, test = prepare(best, Xte)\n        est.fit(train, ytr)\n        return dict(candidate=best, cv=pool[best],\n                    holdout=float(get_scorer(sc.scoring)(est, test, yte)))\n\n    assert max(archive.values()) == max(search.history[\"fitness_best\"])\n    return dict(task=task, seed=seed, search=\"features\" if features else \"hpo\",\n                scoring=sc.scoring, unique=len(archive), folds=len(folds),\n                initial=incumbent(initial), genetic=incumbent(archive), random=incumbent(control),\n                cv_progress=[dict(unique=n, genetic=max(list(archive.values())[:n]),\n                                  random=max(list(control.values())[:n]))\n                             for n in (6, 12, 18, 24, len(archive))])\n\n\nwith threadpool_limits(1):\n    rows = [paired_run(task, seed, features)\n            for task in (\"classification_lr\", \"regression_ridge\")\n            for seed in (1201, 1202, 1203) for features in (False, True)]\nresult = dict(source_commit=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n              python=platform.python_version(),\n              versions={p:version(p) for p in [\"scikit-learn\",\"numpy\",\"scipy\",\"deap\"]},\n              rows=rows, reproduction_script=Path(__file__).read_text(encoding=\"utf-8\"))\npath = Path(sys.argv[1])\npath.write_text(json.dumps(result, indent=2, allow_nan=False)+\"\\n\", encoding=\"utf-8\")\n"
