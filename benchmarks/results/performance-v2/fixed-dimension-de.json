  "reproduction_script": "import ast\nimport json\nimport platform\nimport random\nimport subprocess\nimport sys\nfrom importlib.metadata import version\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nimport numpy as np\nfrom sklearn.metrics import get_scorer\nfrom sklearn.model_selection import train_test_split\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom benchmarks.benchmark_fit import SCENARIOS, make_cv\nfrom sklearn_genetic import GASearchCV, algorithms, optimizer_control\nfrom sklearn_genetic.space import Categorical, Continuous, Integer\n\nbaseline = subprocess.check_output([\"git\", \"rev-parse\", \"e62e1e8\"], text=True).strip()\npath = \"sklearn_genetic/optimizer_control.py\"\nsource = subprocess.check_output([\"git\", \"show\", f\"{baseline}:{path}\"], text=True)\nmethod = next(\n    node for node in ast.parse(source).body if getattr(node, \"name\", \"\") == \"differential_offspring\"\n)\nexec(compile(ast.Module(body=[method], type_ignores=[]), path, \"exec\"), globals())\n\n\ndef paired(task, seed, crossover):\n    sc = SCENARIOS[task]\n    classification = sc.task == \"classification\"\n    X, y = sc.loader()\n    Xtr, Xte, ytr, yte = train_test_split(\n        X, y, test_size=0.25, random_state=seed, stratify=y if classification else None\n    )\n    folds = list(make_cv(sc, 3, seed).split(Xtr, ytr))\n    prefix = \"clf__\" if classification else \"ridge__\"\n    variable = prefix + (\"C\" if classification else \"alpha\")\n    rows = []\n    for operator in (differential_offspring, optimizer_control.differential_offspring):\n        model = sc.estimator_builder(seed)\n        params = model.get_params()\n        grid = {\n            prefix + \"fit_intercept\": Categorical([True]),\n            variable: Continuous(1e-4, 100, distribution=\"log-uniform\"),\n            prefix + \"tol\": Continuous(params[prefix + \"tol\"], params[prefix + \"tol\"]),\n        }\n        if classification:\n            grid[prefix + \"max_iter\"] = Integer(\n                params[prefix + \"max_iter\"], params[prefix + \"max_iter\"]\n            )\n        else:\n            grid[prefix + \"solver\"] = Categorical([params[prefix + \"solver\"]])\n        parent_copies = []\n\n        def observed(population, *args):\n            trials = operator(population, *args)\n            parent_copies.extend(\n                trial == target for trial, target in zip(trials, population, strict=True)\n            )\n            return trials\n\n        search = GASearchCV(\n            model,\n            param_grid=grid,\n            algorithm=\"eaDifferentialEvolution\",\n            cv=folds,\n            scoring=sc.scoring,\n            population_size=6,\n            generations=3,\n            mutation_probability=0,\n            crossover_probability=crossover,\n            random_state=seed,\n            n_jobs=1,\n            error_score=\"raise\",\n            verbose=False,\n            diversity_control=False,\n        )\n        with patch.object(algorithms, \"differential_offspring\", observed):\n            search.fit(Xtr, ytr)\n        rows.append(\n            dict(\n                initial=[p[variable] for p in search.cv_results_[\"params\"][:6]],\n                trials=len(parent_copies),\n                copies=sum(parent_copies),\n                distinct=search.fit_stats_[\"cross_validate_calls\"],\n                best=search.best_params_[variable],\n                holdout=float(get_scorer(sc.scoring)(search.best_estimator_, Xte, yte)),\n            )\n        )\n    assert rows[0][\"initial\"] == rows[1][\"initial\"] and rows[0][\"trials\"] == rows[1][\"trials\"] == 18\n    return dict(task=task, seed=seed, crossover=crossover, baseline=rows[0], current=rows[1])\n\n\nwith threadpool_limits(1):\n    rows = [\n        paired(task, seed, crossover)\n        for task in (\"classification_lr\", \"regression_ridge\")\n        for seed in (1801, 1802, 1803)\n        for crossover in (0, 0.8)\n    ]\nprint(\n    json.dumps(\n        dict(\n            baseline_commit=baseline,\n            python=platform.python_version(),\n            versions={p: version(p) for p in (\"scikit-learn\", \"numpy\", \"deap\")},\n            rows=rows,\n            reproduction_script=Path(__file__).read_text(encoding=\"utf-8\"),\n        ),\n        indent=2,\n    )\n)\n"
}
