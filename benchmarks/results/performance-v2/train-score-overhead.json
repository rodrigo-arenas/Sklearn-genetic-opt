  "reproduction_script": "\"\"\"Measure the cost of unused train-fold scores across HPO model families.\"\"\"\n\nimport json\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_diabetes, load_digits, load_wine, make_classification\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import ElasticNet\nfrom sklearn.model_selection import KFold, StratifiedKFold, train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GASearchCV\nfrom sklearn_genetic.space import Categorical, Continuous, Integer\n\n\ntasks = {\n    \"wine-tree\": dict(\n        data=load_wine(return_X_y=True), model=DecisionTreeClassifier(random_state=0),\n        space={\"max_depth\": Integer(2, 15), \"criterion\": Categorical([\"gini\", \"entropy\"])},\n        regression=False,\n    ),\n    \"digits-knn\": dict(\n        data=load_digits(return_X_y=True),\n        model=make_pipeline(StandardScaler(), KNeighborsClassifier(n_jobs=1)),\n        space={\"kneighborsclassifier__n_neighbors\": Integer(1, 25), \"kneighborsclassifier__weights\": Categorical([\"uniform\", \"distance\"])},\n        regression=False,\n    ),\n    \"diabetes-elasticnet\": dict(\n        data=load_diabetes(return_X_y=True),\n        model=make_pipeline(StandardScaler(), ElasticNet(max_iter=2000, random_state=0)),\n        space={\"elasticnet__alpha\": Continuous(0.001, 10, distribution=\"log-uniform\"), \"elasticnet__l1_ratio\": Continuous(0.01, 0.99)},\n        regression=True,\n    ),\n    \"synthetic-forest\": dict(\n        data=make_classification(n_samples=600, n_features=20, n_informative=8, n_redundant=4, random_state=29),\n        model=RandomForestClassifier(random_state=0, n_jobs=1),\n        space={\"n_estimators\": Integer(20, 60), \"max_depth\": Integer(2, 12)},\n        regression=False,\n    ),\n}\noutput = Path(\".agent-runs/performance-v2/train-score-overhead.jsonl\")\nwith threadpool_limits(limits=1), output.open(\"w\", encoding=\"utf-8\") as stream:\n    for task_name, task in tasks.items():\n        X, y = task[\"data\"]\n        for seed in range(1101, 1104):\n            train, test = train_test_split(\n                np.arange(len(y)), test_size=.25,\n                stratify=None if task[\"regression\"] else y, random_state=seed,\n            )\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            splitter = KFold(3, shuffle=True, random_state=seed) if task[\"regression\"] else StratifiedKFold(3, shuffle=True, random_state=seed)\n            folds = list(splitter.split(Xtr, ytr))\n            modes = (False, True) if seed % 2 else (True, False)\n            for train_scores in modes:\n                search = GASearchCV(\n                    clone(task[\"model\"]), param_grid=task[\"space\"], cv=folds,\n                    scoring=\"neg_mean_squared_error\" if task[\"regression\"] else \"accuracy\",\n                    population_size=8, generations=4, random_state=seed,\n                    n_jobs=1, verbose=False, error_score=\"raise\",\n                    return_train_score=train_scores,\n                )\n                start = time.perf_counter()\n                search.fit(Xtr, ytr)\n                seconds = time.perf_counter() - start\n                row = {\n                    \"task\": task_name, \"seed\": seed, \"train_scores\": train_scores,\n                    \"seconds\": seconds, \"best_cv_score\": float(search.best_score_),\n                    \"cv_evaluations\": int(search.fit_stats_[\"cross_validate_calls\"]),\n                    \"best_params\": {key: value.item() if isinstance(value, np.generic) else value for key, value in search.best_params_.items()},\n                    \"train_result_present\": \"mean_train_score\" in search.cv_results_,\n                }\n                stream.write(json.dumps(row) + \"\\n\")\n                stream.flush()\n                print(task_name, seed, train_scores, f\"seconds={seconds:.3f}\", flush=True)\n"
}
