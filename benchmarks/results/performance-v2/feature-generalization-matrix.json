  "reproduction_script": "\"\"\"Equal-budget feature-mask transfer on unseen task shapes and scoring metrics.\"\"\"\n\nimport json\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom scipy.sparse import csr_matrix\nfrom sklearn.base import clone\nfrom sklearn.datasets import make_classification, make_friedman1, make_regression\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.linear_model import LogisticRegression, Ridge, SGDClassifier\nfrom sklearn.metrics import balanced_accuracy_score, mean_squared_error\nfrom sklearn.model_selection import KFold, StratifiedKFold, cross_val_score, train_test_split\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GAFeatureSelectionCV\n\n\nimbalanced = make_classification(\n    n_samples=600, n_features=40, n_informative=7, n_redundant=6,\n    weights=[0.9, 0.1], flip_y=0.02, random_state=73,\n)\nX_sparse, y_sparse = make_classification(\n    n_samples=500, n_features=80, n_informative=10, n_redundant=8,\n    weights=[0.7, 0.3], random_state=79,\n)\nX_sparse[np.abs(X_sparse) < 1.2] = 0\ntasks = {\n    \"imbalanced-logistic\": dict(\n        data=imbalanced,\n        model=make_pipeline(StandardScaler(), LogisticRegression(max_iter=1000, class_weight=\"balanced\")),\n        scoring=\"balanced_accuracy\", regression=False,\n    ),\n    \"sparse-sgd\": dict(\n        data=(csr_matrix(X_sparse), y_sparse),\n        model=make_pipeline(StandardScaler(with_mean=False), SGDClassifier(loss=\"log_loss\", max_iter=1000, random_state=0)),\n        scoring=\"balanced_accuracy\", regression=False,\n    ),\n    \"linear-ridge\": dict(\n        data=make_regression(n_samples=600, n_features=30, n_informative=6, noise=20, random_state=83),\n        model=make_pipeline(StandardScaler(), Ridge(alpha=1)),\n        scoring=\"neg_mean_squared_error\", regression=True,\n    ),\n    \"friedman-forest\": dict(\n        data=make_friedman1(n_samples=500, n_features=20, noise=1, random_state=89),\n        model=RandomForestRegressor(n_estimators=30, max_depth=8, random_state=0, n_jobs=1),\n        scoring=\"neg_mean_squared_error\", regression=True,\n    ),\n}\n\noutput = Path(\".agent-runs/performance-v2/feature-generalization-matrix.jsonl\")\nwith threadpool_limits(limits=1), output.open(\"w\", encoding=\"utf-8\") as stream:\n    for task_name, task in tasks.items():\n        X, y = task[\"data\"]\n        cap = X.shape[1] // 2\n        for seed in range(1081, 1086):\n            train, test = train_test_split(\n                np.arange(len(y)), test_size=0.25,\n                stratify=None if task[\"regression\"] else y, random_state=seed,\n            )\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            splitter = KFold(3, shuffle=True, random_state=seed) if task[\"regression\"] else StratifiedKFold(3, shuffle=True, random_state=seed)\n            folds = list(splitter.split(Xtr, ytr))\n            methods = (\"genetic\", \"random\") if seed % 2 else (\"random\", \"genetic\")\n            for method in methods:\n                started = time.perf_counter()\n                if method == \"genetic\":\n                    search = GAFeatureSelectionCV(\n                        clone(task[\"model\"]), cv=folds, scoring=task[\"scoring\"],\n                        max_features=cap, population_size=8, generations=4,\n                        random_state=seed, n_jobs=1, verbose=False, error_score=\"raise\",\n                    ).fit(Xtr, ytr)\n                    mask = np.asarray(search.support_, dtype=bool)\n                    cv_score = float(np.nanmax(search.cv_results_[\"mean_test_score\"]))\n                    calls = search.fit_stats_[\"cross_validate_calls\"]\n                    proposals = search.fit_stats_[\"evaluated_candidates\"]\n                    fitted = search.best_estimator_\n                else:\n                    rng = np.random.default_rng(seed)\n                    scored = {}\n                    for _ in range(72):\n                        count = int(rng.integers(1, cap + 1))\n                        indices = rng.choice(X.shape[1], count, replace=False)\n                        candidate = np.zeros(X.shape[1], dtype=bool)\n                        candidate[indices] = True\n                        key = tuple(candidate)\n                        if key not in scored:\n                            scored[key] = float(np.mean(cross_val_score(\n                                clone(task[\"model\"]), Xtr[:, candidate], ytr,\n                                cv=folds, scoring=task[\"scoring\"], n_jobs=1, error_score=\"raise\",\n                            )))\n                    best_key = max(scored, key=lambda key: (scored[key], -sum(key)))\n                    mask = np.asarray(best_key, dtype=bool)\n                    cv_score = scored[best_key]\n                    calls = len(scored)\n                    proposals = 72\n                    fitted = clone(task[\"model\"]).fit(Xtr[:, mask], ytr)\n                predictions = fitted.predict(Xte[:, mask])\n                holdout = (\n                    -mean_squared_error(yte, predictions)\n                    if task[\"regression\"] else balanced_accuracy_score(yte, predictions)\n                )\n                row = dict(\n                    task=task_name, seed=seed, method=method,\n                    seconds=time.perf_counter() - started,\n                    cv_score=float(cv_score), holdout=float(holdout),\n                    selected_features=int(mask.sum()), candidate_cv_calls=int(calls),\n                    proposals=int(proposals), mask=np.flatnonzero(mask).tolist(),\n                )\n                stream.write(json.dumps(row) + \"\\n\")\n                stream.flush()\n                print(task_name, seed, method, f\"holdout={holdout:.6f}\",\n                      f\"seconds={row['seconds']:.3f}\", flush=True)\n"
}
