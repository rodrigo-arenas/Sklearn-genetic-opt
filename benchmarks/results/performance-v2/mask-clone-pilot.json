  "reproduction_script": "import json\nimport platform\nimport gc\nimport subprocess\nimport sys\nimport time\nfrom importlib.metadata import version\nfrom pathlib import Path\nfrom types import ModuleType\nfrom unittest.mock import patch\n\nimport numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom sklearn_genetic import GAFeatureSelectionCV, genetic_search, population\n\nfrom copy import deepcopy\n\nbaseline = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip()\n\n\ndef clone_mask(parent):\n    child = type(parent)(parent)\n    child.__dict__.update(deepcopy(parent.__dict__, {id(parent): child}))\n    return child\n\n\nclass Experimental(GAFeatureSelectionCV):\n    def _register(self):\n        super()._register()\n        self.toolbox.register(\"clone\", clone_mask)\n\n\nmethods = (GAFeatureSelectionCV, Experimental)\noriginal_cv = genetic_search.cross_validate\n\n\ndef measure(X, y, seed, method):\n    stage = {\"candidate_cv_ms\": 0.0}\n\n    def validation(*args, **kwargs):\n        start = time.perf_counter()\n        result = original_cv(*args, **kwargs)\n        stage[\"candidate_cv_ms\"] += 1000 * (time.perf_counter() - start)\n        return result\n\n    search = method(\n        DecisionTreeClassifier(max_depth=3, random_state=seed),\n        population_size=8,\n        generations=1,\n        max_features=12,\n        scoring=\"balanced_accuracy\",\n        cv=3,\n        n_jobs=1,\n        random_state=seed,\n        error_score=\"raise\",\n        verbose=False,\n    )\n    gc.collect()\n    with patch.object(genetic_search, \"cross_validate\", validation):\n        start = time.perf_counter()\n        search.fit(X[:120], y[:120])\n        stage[\"total_ms\"] = 1000 * (time.perf_counter() - start)\n    stage[\"other_ms\"] = stage[\"total_ms\"] - stage[\"candidate_cv_ms\"]\n    stage[\"cv_calls\"] = search.fit_stats_[\"cross_validate_calls\"]\n    assert stage[\"cv_calls\"] == 24\n    outcome = (\n        np.asarray(search.cv_results_[\"features\"]),\n        search.cv_results_[\"mean_test_score\"],\n        search.support_,\n        search.predict(X[120:]),\n    )\n    return stage, outcome\n\n\nfits = []\nwith threadpool_limits(1):\n    for seed in range(2301, 2306):\n        X, y = make_classification(\n            n_samples=180, n_features=4096, n_informative=16, n_redundant=0, random_state=seed\n        )\n        if not fits:\n            for method in methods:\n                measure(X, y, seed, method)\n        reference = None\n        for block, order in enumerate([(0, 1), (1, 0), (1, 0), (0, 1)]):\n            for position, i in enumerate(order):\n                stage, outcome = measure(X, y, seed, methods[i])\n                if reference is None:\n                    reference = outcome\n                else:\n                    for before, after in zip(reference, outcome, strict=True):\n                        np.testing.assert_array_equal(before, after)\n                fits.append(\n                    dict(\n                        seed=seed,\n                        block=block,\n                        position=position,\n                        method=(\"default\", \"experimental\")[i],\n                        **stage,\n                    )\n                )\nprint(\n    json.dumps(\n        dict(\n            baseline=baseline,\n            current_commit=subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip(),\n            python=platform.python_version(),\n            versions={p: version(p) for p in (\"numpy\", \"scikit-learn\", \"deap\")},\n            fits=fits,\n            reproduction_script=Path(__file__).read_text(),\n        ),\n        indent=2,\n    )\n)\n"
}
