  "reproduction_script": "import gc\nimport itertools\nimport json\nimport platform\nimport random\nimport statistics\nimport subprocess\nimport sys\nimport time\nimport tracemalloc\nfrom pathlib import Path\n\nimport numpy as np\n\nsys.path.insert(0, str(Path.cwd()))\nfrom sklearn_genetic.algorithms import _population_diversity as baseline\n\n\ndef stacked(population):\n    n = len(population)\n    rows = [bytes(mask) for mask in population]\n    width = len(rows[0])\n    if width == 0 or any(len(row) != width for row in rows):\n        return baseline(population)\n    matrix = np.frombuffer(b\"\".join(rows), dtype=np.uint8).reshape(n, width)\n    if matrix.max() > 1:\n        return baseline(population)\n    ones = matrix.sum(axis=0, dtype=np.int64)\n    zeros = n - ones\n    equal_pairs = ones * (ones - 1) + zeros * (zeros - 1)\n    unique = len(set(rows))\n    return dict(population_size=n, unique_individuals=unique, unique_individual_ratio=unique/n,\n                genotype_diversity=float(np.mean(1 - equal_pairs / (n * (n - 1)))))\n\n\ndef streamed(population):\n    n = len(population)\n    width = len(population[0])\n    counts = np.zeros(width, dtype=np.int64)\n    keys = set()\n    for mask in population:\n        row = np.frombuffer(bytes(mask), dtype=np.uint8)\n        if len(row) != width or not width or row.max() > 1:\n            return baseline(population)\n        counts += row\n        keys.add(np.packbits(row).tobytes())\n    # Keep the same order of floating-point operations as the baseline.\n    equal_pairs = n * (n - 1) - 2 * counts * (n - counts)\n    return dict(population_size=n, unique_individuals=len(keys), unique_individual_ratio=len(keys)/n,\n                genotype_diversity=float(np.mean(1 - equal_pairs / (n * (n - 1)))))\n\n\nmethods = [baseline, stacked, streamed]\nrecords = []\nfor n, width in [(8, 16), (8, 4096), (32, 4096), (64, 8192)]:\n    for template_count in (n, max(2, n // 8)):\n        rng = random.Random(3001)\n        templates = [[rng.randrange(2) for _ in range(width)] for _ in range(template_count)]\n        population = [templates[i % template_count].copy() for i in range(n)]\n        expected = baseline(population)\n        for method in methods:\n            assert method(population) == expected\n        times = {m.__name__: [] for m in methods}\n        peaks = {m.__name__: [] for m in methods}\n        for order in itertools.permutations(methods):\n            for method in order:\n                start = time.perf_counter()\n                result = method(population)\n                times[method.__name__].append(1000 * (time.perf_counter() - start))\n                assert result == expected\n        for method in methods:\n            for _ in range(3):\n                gc.collect()\n                tracemalloc.start()\n                try:\n                    assert method(population) == expected\n                    peaks[method.__name__].append(tracemalloc.get_traced_memory()[1])\n                finally:\n                    tracemalloc.stop()\n        records.append(dict(n=n,width=width,unique=expected[\"unique_individuals\"],\n                            times_ms=times,peak_bytes=peaks))\nprint(json.dumps(dict(checkout=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n                      python=platform.python_version(),numpy=np.__version__,records=records,\n                      reproduction_script=Path(__file__).read_text()),indent=2))\n"
