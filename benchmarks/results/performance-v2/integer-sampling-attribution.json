  "protocol": "Timed Integer.sample calls inside paired fits; initial warmup per mode and method excluded. One thread. Fit timings include timer overhead. Both orders per seed.",
  "reproduction_script": "import json\nimport platform\nimport subprocess\nfrom importlib.metadata import version\nfrom pathlib import Path\nfrom statistics import median\nfrom time import perf_counter_ns\nfrom unittest.mock import patch\n\nimport numpy as np\nfrom sklearn.datasets import load_iris\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn_genetic import GASearchCV\nfrom sklearn_genetic.space import Integer\nfrom sklearn_genetic.space import space as space_module\nfrom threadpoolctl import threadpool_limits\n\nbaseline = \"63696a6fe750a6a092653220c0d5c8466aad9d41\"\nns = dict(vars(space_module))\nexec(subprocess.check_output([\"git\", \"show\", baseline + \":sklearn_genetic/space/space.py\"]), ns)\nversions = {\"previous\": (ns[\"Integer\"].__init__,ns[\"Integer\"].sample),\n            \"current\": (Integer.__init__,Integer.sample)}\n\ndef run(mode, seed, label, X, y):\n    init, draw = versions[label]\n    elapsed_ns = calls = 0\n    def measured(dim):\n        nonlocal elapsed_ns, calls\n        start = perf_counter_ns()\n        value = draw(dim)\n        elapsed_ns += perf_counter_ns() - start\n        calls += 1\n        return value\n    with patch.object(Integer,\"__init__\",init), patch.object(Integer,\"sample\",measured):\n        grid = {name:Integer(lo,hi) for name,lo,hi in (\n            (\"max_depth\",1,20),(\"min_samples_leaf\",1,16),\n            (\"min_samples_split\",2,20),(\"max_leaf_nodes\",2,40))}\n        search = GASearchCV(DecisionTreeClassifier(random_state=11),param_grid=grid,\n            cv=2,scoring=\"balanced_accuracy\",population_size=8,generations=2,\n            population_initializer=mode,n_jobs=1,random_state=seed,verbose=False)\n        start = perf_counter_ns()\n        search.fit(X,y)\n        total_ns = perf_counter_ns() - start\n    return search,dict(fit_ms=total_ns/1e6,sample_ms=elapsed_ns/1e6,draws=calls,\n                       cv_calls=search.fit_stats_[\"cross_validate_calls\"])\n\nX,y = load_iris(return_X_y=True)\nrows = []\nwith threadpool_limits(1):\n    for mode in (\"smart\",\"random\"):\n        for label in versions:\n            run(mode,7,label,X,y)\n        for seed in (3,19,41,53,67,79):\n            for order in ((\"previous\",\"current\"),(\"current\",\"previous\")):\n                fits = {}; stats = {}\n                for label in order:\n                    fits[label],stats[label] = run(mode,seed,label,X,y)\n                a,b = fits.values()\n                assert a.cv_results_[\"params\"] == b.cv_results_[\"params\"]\n                np.testing.assert_array_equal(a.cv_results_[\"mean_test_score\"],b.cv_results_[\"mean_test_score\"])\n                assert a.fit_stats_ == b.fit_stats_\n                assert stats[\"current\"][\"draws\"] == stats[\"previous\"][\"draws\"]\n                rows.append(dict(mode=mode,seed=seed,order=order,results=stats))\n        group=[r[\"results\"] for r in rows if r[\"mode\"]==mode]\n        print(mode,\"median % change in fit time\", round(median(100*(r[\"current\"][\"fit_ms\"]/r[\"previous\"][\"fit_ms\"]-1) for r in group),2),\n              \"faster\",sum(r[\"current\"][\"fit_ms\"]<r[\"previous\"][\"fit_ms\"] for r in group),\n              \"median draws\",median(r[\"current\"][\"draws\"] for r in group),\n              \"median sampler ms\",[round(median(r[k][\"sample_ms\"] for r in group),3) for k in versions],flush=True)\npath=Path(\"benchmarks/results/performance-v2/integer-sampling-attribution.json\")\npath.write_text(json.dumps(dict(previous=baseline,current=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n    python=platform.python_version(),versions={p:version(p) for p in (\"numpy\",\"scipy\",\"scikit-learn\")},\n    protocol=\"Timed Integer.sample calls inside paired fits; initial warmup per mode and method excluded. One thread. Fit timings include timer overhead. Both orders per seed.\",reproduction_script=Path(__file__).read_text(encoding='utf8'),rows=rows),indent=2)+\"\\n\",encoding=\"utf8\")\n",
