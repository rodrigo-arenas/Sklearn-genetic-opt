  "reproduction_script": "import json\nimport platform\nimport subprocess\nimport sys\nfrom importlib.metadata import version\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nfrom time import perf_counter\n\nimport numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.tree import DecisionTreeClassifier\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom sklearn_genetic import GAFeatureSelectionCV, GASearchCV\nfrom sklearn_genetic.callbacks import ModelCheckpoint\nfrom sklearn_genetic.space import Integer\n\nprior = \"7729bad\"\nsource = subprocess.check_output(\n    [\"git\", \"show\", f\"{prior}:sklearn_genetic/callbacks/model_checkpoint.py\"], text=True\n)\nnamespace = {\"__name__\": \"sklearn_genetic.callbacks.reference\"}\nexec(source, namespace)\nwriters = {\"previous\": namespace[\"ModelCheckpoint\"].on_step, \"atomic\": ModelCheckpoint.on_step}\n\n\nclass TimedCheckpoint(ModelCheckpoint):\n    def __init__(self, path, writer):\n        super().__init__(path)\n        self.writer = writer\n        self.ms = []\n        self.sizes = []\n\n    def on_step(self, record=None, logbook=None, estimator=None):\n        start = perf_counter()\n        self.writer(self, record, logbook, estimator)\n        self.ms.append(1000 * (perf_counter() - start))\n        self.sizes.append(self.checkpoint_path.stat().st_size)\n\n\ndef run(kind, arm, seed, X, y):\n    options = dict(\n        estimator=DecisionTreeClassifier(max_depth=4, random_state=seed),\n        cv=2, scoring=\"accuracy\", random_state=seed, population_size=6,\n        generations=3, n_jobs=1, verbose=False, error_score=\"raise\",\n    )\n    if kind == \"features\":\n        search = GAFeatureSelectionCV(max_features=12, **options)\n    else:\n        search = GASearchCV(param_grid={\n            \"max_depth\": Integer(2, 16), \"min_samples_leaf\": Integer(1, 12),\n        }, **options)\n    with TemporaryDirectory() as folder:\n        callback = TimedCheckpoint(Path(folder) / \"search.pkl\", writers[arm])\n        start = perf_counter()\n        search.fit(X[:96], y[:96], callbacks=[callback])\n        fit_ms = 1000 * (perf_counter() - start)\n        saved = callback.load()\n    state = saved[\"runtime_state\"]\n    key = \"features\" if kind == \"features\" else \"params\"\n    outcome = (\n        search.cv_results_[key], search.cv_results_[\"mean_test_score\"], search.predict(X[96:]),\n        saved[\"logbook\"].select(\"gen\"), saved[\"logbook\"].select(\"fitness_best\"),\n        state[\"fit_stats_\"][\"cross_validate_calls\"], list(state[\"fitness_cache\"]),\n        [v[\"fitness\"] for v in state[\"fitness_cache\"].values()],\n        state[\"candidate_logbook\"].chapters[\"parameters\"].select(\"score\"),\n    )\n    assert len(callback.ms) == 4\n    return dict(fit_ms=fit_ms, checkpoint_ms=callback.ms, sizes=callback.sizes), outcome\n\n\nrecords = []\nwith threadpool_limits(1):\n    for kind, width in [(\"hyperparameters\", 16), (\"features\", 512)]:\n        for seed in (2601, 2602, 2603):\n            X, y = make_classification(n_samples=144, n_features=width, n_informative=8,\n                                       random_state=seed)\n            if seed == 2601:\n                for arm in writers:\n                    run(kind, arm, seed, X, y)\n            for order in [list(writers), list(reversed(writers))]:\n                pair = dict(kind=kind, width=width, seed=seed, order=order)\n                expected = None\n                for arm in order:\n                    pair[arm], outcome = run(kind, arm, seed, X, y)\n                    if expected is not None:\n                        for left, right in zip(expected, outcome, strict=True):\n                            np.testing.assert_equal(left, right)\n                    expected = outcome\n                records.append(pair)\nprint(json.dumps(dict(\n    reference=prior, checkout=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n    platform=platform.system(), python=platform.python_version(),\n    versions={p: version(p) for p in (\"scikit-learn\",\"numpy\",\"deap\",\"joblib\")},\n    records=records, reproduction_script=Path(__file__).read_text(),\n), indent=2))\n"
