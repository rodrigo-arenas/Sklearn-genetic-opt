  "reproduction_script": "import ast\nimport json\nimport platform\nimport subprocess\nimport sys\nfrom importlib.metadata import version\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_wine\nfrom sklearn.metrics import get_scorer\nfrom sklearn.model_selection import train_test_split\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom benchmarks.benchmark_fit import SCENARIOS, make_cv\nfrom sklearn_genetic import GASearchCV, optimizer_control\nfrom sklearn_genetic.space import Categorical, Continuous, Integer\n\nbaseline = subprocess.check_output([\"git\", \"rev-parse\", \"cae9eb7\"], text=True).strip()\npath = \"sklearn_genetic/optimizer_control.py\"\nsource = subprocess.check_output([\"git\", \"show\", f\"{baseline}:{path}\"], text=True)\nmethod = next(\n    node for node in ast.parse(source).body if getattr(node, \"name\", \"\") == \"_search_space_neighbor\"\n)\nexec(\n    compile(ast.Module(body=[method], type_ignores=[]), path, \"exec\"),\n    {**vars(optimizer_control)},\n    old := {},\n)\n\n\ndef paired(task, seed):\n    sc = SCENARIOS[\"classification_lr\" if task == \"wine_lr\" else task]\n    classification = sc.task == \"classification\"\n    X, y = load_wine(return_X_y=True) if task == \"wine_lr\" else sc.loader()\n    Xtr, Xte, ytr, yte = train_test_split(\n        X, y, test_size=0.25, random_state=seed, stratify=y if classification else None\n    )\n    folds = list(make_cv(sc, 3, seed).split(Xtr, ytr))\n    prefix = \"clf__\" if classification else \"ridge__\"\n    variable = prefix + (\"C\" if classification else \"alpha\")\n    scoring = \"balanced_accuracy\" if task == \"wine_lr\" else sc.scoring\n    model = sc.estimator_builder(seed)\n    if task == \"wine_lr\":\n        model.set_params(clf__solver=\"lbfgs\")\n    rows = []\n    for operator in (old[\"_search_space_neighbor\"], optimizer_control._search_space_neighbor):\n        params = model.get_params()\n        grid = {\n            prefix + \"fit_intercept\": Categorical([True]),\n            variable: Continuous(1e-4, 100, distribution=\"log-uniform\"),\n            prefix + \"tol\": Continuous(params[prefix + \"tol\"], params[prefix + \"tol\"]),\n        }\n        if classification:\n            grid[prefix + \"max_iter\"] = Integer(\n                params[prefix + \"max_iter\"], params[prefix + \"max_iter\"]\n            )\n        else:\n            grid[prefix + \"solver\"] = Categorical([params[prefix + \"solver\"]])\n        search = GASearchCV(\n            model,\n            param_grid=grid,\n            local_search=True,\n            local_search_steps=8,\n            local_search_radius=0.1,\n            cv=folds,\n            scoring=scoring,\n            population_size=6,\n            refit=False,\n            generations=0,\n            mutation_probability=0,\n            random_state=seed,\n            n_jobs=1,\n            error_score=\"raise\",\n            verbose=False,\n            diversity_control=False,\n        )\n        with patch.object(optimizer_control, \"_search_space_neighbor\", operator):\n            search.fit(Xtr, ytr)\n        table = search.cv_results_\n        unique = {}\n        for proposal, (param, score) in enumerate(\n            zip(table[\"params\"], table[\"mean_test_score\"], strict=True), start=1\n        ):\n            unique.setdefault(param[variable], (proposal, float(score)))\n        assert len(unique) == search.fit_stats_[\"cross_validate_calls\"]\n        assert len(table[\"params\"]) == search.fit_stats_[\"evaluated_candidates\"]\n        assert len(table[\"params\"]) == 14\n        rows.append(unique)\n    assert list(rows[0].items())[:6] == list(rows[1].items())[:6]\n    budget = min(len(h) for h in rows)\n    measurements = []\n    for history in rows:\n        record = {}\n        for key, limit in [(\"equal_steps\", len(history)), (\"equal_fits\", budget)]:\n            items = list(history.items())[:limit]\n            winner, (_, score) = max(items, key=lambda item: item[1][1])\n            fitted = clone(model).set_params(**{variable: winner}).fit(Xtr, ytr)\n            record[key] = dict(\n                unique=limit,\n                winner=winner,\n                cv=score,\n                holdout=float(get_scorer(scoring)(fitted, Xte, yte)),\n            )\n        record[\"trajectory\"] = [dict(value=v, proposal=p, cv=s) for v, (p, s) in history.items()]\n        measurements.append(record)\n    return dict(\n        task=task, scoring=scoring, seed=seed, baseline=measurements[0], current=measurements[1]\n    )\n\n\nwith threadpool_limits(1):\n    rows = [\n        paired(task, seed)\n        for task in (\"classification_lr\", \"regression_ridge\", \"wine_lr\")\n        for seed in (2001, 2002, 2003)\n    ]\nprint(\n    json.dumps(\n        dict(\n            baseline_commit=baseline,\n            python=platform.python_version(),\n            versions={p: version(p) for p in (\"scikit-learn\", \"numpy\", \"deap\")},\n            rows=rows,\n            reproduction_script=Path(__file__).read_text(encoding=\"utf-8\"),\n        ),\n        indent=2,\n    )\n)\n"
}
