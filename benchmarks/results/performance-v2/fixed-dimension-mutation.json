  "reproduction_script": "import ast\nimport json\nimport platform\nimport random\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom importlib.metadata import version\n\nfrom sklearn.metrics import get_scorer\nfrom sklearn.model_selection import train_test_split\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, str(Path.cwd()))\nfrom benchmarks.benchmark_fit import SCENARIOS, make_cv\nfrom sklearn_genetic import GASearchCV\nfrom sklearn_genetic.space import Categorical, Continuous, Integer\n\nbaseline = subprocess.check_output([\"git\", \"rev-parse\", \"76d6b81\"], text=True).strip()\npath = \"sklearn_genetic/genetic_search.py\"\nsource = subprocess.check_output([\"git\", \"show\", f\"{baseline}:{path}\"], text=True)\nmethod = next(\n    fn\n    for cls in ast.parse(source).body\n    if getattr(cls, \"name\", \"\") == \"GASearchCV\"\n    for fn in cls.body\n    if getattr(fn, \"name\", \"\") == \"mutate\"\n)\nexec(compile(ast.Module(body=[method], type_ignores=[]), path, \"exec\"), globals())\n\n\nclass BaselineSearch(GASearchCV):\n    mutate = mutate\n\n\nclass CountMutations:\n    calls = 0\n    unchanged = 0\n\n    def mutate(self, individual):\n        before = tuple(individual)\n        result = super().mutate(individual)\n        self.calls += 1\n        self.unchanged += before == tuple(individual)\n        return result\n\n\nclass ObservedBaseline(CountMutations, BaselineSearch):\n    pass\n\n\nclass ObservedCurrent(CountMutations, GASearchCV):\n    pass\n\n\ndef paired(task, seed, diversity):\n    sc = SCENARIOS[task]\n    X, y = sc.loader()\n    classification = sc.task == \"classification\"\n    Xtr, Xte, ytr, yte = train_test_split(\n        X, y, test_size=0.25, random_state=seed, stratify=y if classification else None\n    )\n    folds = list(make_cv(sc, 3, seed).split(Xtr, ytr))\n    prefix = \"clf__\" if classification else \"ridge__\"\n    name = prefix + (\"C\" if classification else \"alpha\")\n    rows = []\n    for cls in (ObservedBaseline, ObservedCurrent):\n        pipeline = sc.estimator_builder(seed)\n        defaults = pipeline.get_params()\n        grid = {\n            name: Continuous(1e-4, 100, distribution=\"log-uniform\"),\n            prefix + \"fit_intercept\": Categorical([True]),\n            prefix + \"tol\": Continuous(defaults[prefix + \"tol\"], defaults[prefix + \"tol\"]),\n        }\n        if classification:\n            grid[prefix + \"max_iter\"] = Integer(\n                defaults[prefix + \"max_iter\"], defaults[prefix + \"max_iter\"]\n            )\n        else:\n            grid[prefix + \"solver\"] = Categorical([defaults[prefix + \"solver\"]])\n        search = cls(\n            pipeline,\n            param_grid=grid,\n            cv=folds,\n            scoring=sc.scoring,\n            population_size=6,\n            generations=3,\n            diversity_control=diversity,\n            random_state=seed,\n            n_jobs=1,\n            verbose=False,\n            error_score=\"raise\",\n        )\n        search.fit(Xtr, ytr)\n        values = [params[name] for params in search.cv_results_[\"params\"]]\n        assert len(set(values)) == search.fit_stats_[\"cross_validate_calls\"]\n        rows.append(\n            dict(\n                initial=values[:6],\n                mutation_calls=search.calls,\n                unchanged_mutations=search.unchanged,\n                replacements=sum(search.history[\"duplicate_replacements\"]),\n                distinct=len(set(values)),\n                proposals=len(values),\n                holdout=float(get_scorer(sc.scoring)(search.best_estimator_, Xte, yte)),\n            )\n        )\n    assert rows[0][\"initial\"] == rows[1][\"initial\"]\n    return dict(task=task, seed=seed, diversity=diversity, baseline=rows[0], current=rows[1])\n\n\nwith threadpool_limits(1):\n    rows = [\n        paired(task, seed, diversity)\n        for task in (\"classification_lr\", \"regression_ridge\")\n        for seed in (1701, 1702, 1703)\n        for diversity in (True, False)\n    ]\nprint(\n    json.dumps(\n        dict(\n            baseline_commit=baseline,\n            python=platform.python_version(),\n            versions={p: version(p) for p in (\"scikit-learn\", \"numpy\", \"deap\")},\n            rows=rows,\n            reproduction_script=Path(__file__).read_text(encoding=\"utf-8\"),\n        ),\n        indent=2,\n    )\n)\n"
