  "reproduction_script": "import gc\nimport itertools\nimport json\nimport platform\nimport random\nimport statistics\nimport subprocess\nimport sys\nimport time\nimport tracemalloc\nfrom pathlib import Path\n\nimport numpy as np\n\nsys.path.insert(0, str(Path.cwd()))\nfrom sklearn_genetic.algorithms import _population_diversity as baseline\n\n\nfrom sklearn_genetic.algorithms import feature_population_diversity\n\n\nmethods = [baseline, feature_population_diversity]\nrecords = []\nfor n, width in [(8, 16), (8, 4096), (32, 4096), (64, 8192)]:\n    for template_count in (n, max(2, n // 8)):\n        rng = random.Random(3001)\n        templates = [[rng.randrange(2) for _ in range(width)] for _ in range(template_count)]\n        population = [templates[i % template_count].copy() for i in range(n)]\n        expected = baseline(population)\n        for method in methods:\n            assert method(population) == expected\n        times = {m.__name__: [] for m in methods}\n        peaks = {m.__name__: [] for m in methods}\n        for order in list(itertools.permutations(methods)) * 3:\n            for method in order:\n                start = time.perf_counter()\n                result = method(population)\n                times[method.__name__].append(1000 * (time.perf_counter() - start))\n                assert result == expected\n        for method in methods:\n            for _ in range(3):\n                gc.collect()\n                tracemalloc.start()\n                try:\n                    assert method(population) == expected\n                    peaks[method.__name__].append(tracemalloc.get_traced_memory()[1])\n                finally:\n                    tracemalloc.stop()\n        records.append(dict(n=n,width=width,unique=expected[\"unique_individuals\"],\n                            times_ms=times,peak_bytes=peaks))\nprint(json.dumps(dict(checkout=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n                      python=platform.python_version(),numpy=np.__version__,records=records,\n                      reproduction_script=Path(__file__).read_text()),indent=2))\n"
}
