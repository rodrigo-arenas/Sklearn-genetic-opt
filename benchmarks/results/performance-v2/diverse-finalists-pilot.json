  "reproduction_script": "\"\"\"Compare rank-only and diversity-aware feature finalists from one GA trajectory.\"\"\"\n\nimport argparse\nimport json\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_breast_cancer, load_digits, make_classification\nfrom sklearn.metrics import accuracy_score\nfrom sklearn.model_selection import StratifiedKFold, cross_val_score, train_test_split\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.svm import SVC\nfrom threadpoolctl import threadpool_limits\n\nfrom sklearn_genetic import GAFeatureSelectionCV\n\n\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--seed-start\", type=int, default=971)\nparser.add_argument(\"--seeds\", type=int, default=3)\nparser.add_argument(\"--pool\", type=int, default=24)\nparser.add_argument(\"--diversity-weight\", type=float, default=0.5)\nparser.add_argument(\"--output\", type=Path, default=Path(\".agent-runs/performance-v2/diverse-finalists-pilot.jsonl\"))\nargs = parser.parse_args()\nwork = Path(\".agent-runs/performance-v2\")\ndatasets = {\n    \"breast\": load_breast_cancer(return_X_y=True),\n    \"digits\": load_digits(return_X_y=True),\n    \"synthetic\": make_classification(\n        n_samples=800, n_features=20, n_informative=8, n_redundant=4, random_state=19\n    ),\n}\n\n\ndef diverse_indices(candidates, masks):\n    selected = [candidates[0]]\n    while len(selected) < min(8, len(candidates)):\n        choices = [index for index in candidates if index not in selected]\n        next_index = max(\n            choices,\n            key=lambda index: (\n                (len(candidates) - candidates.index(index)) / len(candidates)\n                + args.diversity_weight\n                * min(np.mean(masks[index] != masks[prior]) for prior in selected),\n                -candidates.index(index),\n            ),\n        )\n        selected.append(next_index)\n    return selected\n\n\nwith threadpool_limits(limits=1), args.output.open(\n    \"w\", encoding=\"utf-8\"\n) as stream:\n    for dataset, (X, y) in datasets.items():\n        for seed in range(args.seed_start, args.seed_start + args.seeds):\n            train, test = train_test_split(\n                np.arange(len(y)), test_size=0.25, stratify=y, random_state=seed\n            )\n            Xtr, Xte, ytr, yte = X[train], X[test], y[train], y[test]\n            folds = list(StratifiedKFold(5, shuffle=True, random_state=seed).split(Xtr, ytr))\n            model = make_pipeline(StandardScaler(), SVC(kernel=\"rbf\", C=10))\n            search = GAFeatureSelectionCV(\n                clone(model),\n                cv=folds[:1],\n                scoring=\"accuracy\",\n                max_features=X.shape[1] // 2,\n                population_size=8,\n                generations=10,\n                random_state=seed,\n                n_jobs=1,\n                verbose=False,\n                error_score=\"raise\",\n                final_selection=False,\n            )\n            started = time.perf_counter()\n            search.fit(Xtr, ytr)\n            search_seconds = time.perf_counter() - started\n            search.final_selection_top_k = 8\n            top8 = search._top_candidate_indices()\n            search.final_selection_top_k = args.pool\n            pool = search._top_candidate_indices()\n            masks = [np.asarray(mask, dtype=bool) for mask in search.cv_results_[\"features\"]]\n            diverse8 = diverse_indices(pool, masks)\n            union = sorted(set(top8) | set(diverse8))\n            full_scores = {}\n            validation_seconds = {}\n            for index in union:\n                began = time.perf_counter()\n                full_scores[index] = float(\n                    np.mean(\n                        cross_val_score(\n                            clone(model),\n                            Xtr[:, masks[index]],\n                            ytr,\n                            cv=folds,\n                            scoring=\"accuracy\",\n                            n_jobs=1,\n                            error_score=\"raise\",\n                        )\n                    )\n                )\n                validation_seconds[index] = time.perf_counter() - began\n            variants = {}\n            for name, finalists in ((\"top8\", top8), (\"diverse8\", diverse8)):\n                winner = max(finalists, key=lambda index: (full_scores[index], -masks[index].sum()))\n                began = time.perf_counter()\n                fitted = clone(model).fit(Xtr[:, masks[winner]], ytr)\n                refit_seconds = time.perf_counter() - began\n                variants[name] = dict(\n                    finalist_indices=[int(index) for index in finalists],\n                    selected_index=int(winner),\n                    score=full_scores[winner],\n                    holdout=float(accuracy_score(yte, fitted.predict(Xte[:, masks[winner]]))),\n                    features=int(masks[winner].sum()),\n                    seconds=search_seconds\n                    + sum(validation_seconds[index] for index in finalists)\n                    + refit_seconds,\n                )\n            row = dict(\n                dataset=dataset,\n                seed=seed,\n                pool=args.pool,\n                diversity_weight=args.diversity_weight,\n                search_seconds=search_seconds,\n                candidate_cv_calls=search.fit_stats_[\"cross_validate_calls\"],\n                finalist_union_size=len(union),\n                top8_overlap=len(set(top8) & set(diverse8)),\n                top8=variants[\"top8\"],\n                diverse8=variants[\"diverse8\"],\n            )\n            stream.write(json.dumps(row) + \"\\n\")\n            stream.flush()\n            print(json.dumps(row), flush=True)\n",
  "summary_script": "\"\"\"Freeze paired feature-finalist diversity pilot and validation.\"\"\"\n\nimport hashlib\nimport importlib.metadata\nimport json\nimport math\nimport platform\nimport statistics\nimport subprocess\nfrom pathlib import Path\n\n\nwork = Path(\".agent-runs/performance-v2\")\npaths = [\n    work / \"diverse-finalists-pilot.jsonl\",\n    work / \"diverse-finalists-strong.jsonl\",\n    work / \"diverse-finalists-validation.jsonl\",\n]\ncohorts = [\n    (\"moderate_pilot\", range(971, 974), 24, 0.5),\n    (\"strong_pilot\", range(974, 977), 64, 2.0),\n    (\"strong_validation\", range(977, 982), 64, 2.0),\n]\nrecords = []\nfor path, (cohort, seeds, pool, weight) in zip(paths, cohorts):\n    rows = [json.loads(line) for line in path.read_text(encoding=\"utf-8\").splitlines()]\n    expected = {(dataset, seed) for dataset in (\"breast\", \"digits\", \"synthetic\") for seed in seeds}\n    by_key = {(row[\"dataset\"], row[\"seed\"]): row for row in rows}\n    assert len(rows) == len(by_key) == len(expected)\n    assert set(by_key) == expected\n    for row in rows:\n        assert row[\"candidate_cv_calls\"] <= 168\n        assert row[\"finalist_union_size\"] == len(\n            set(row[\"top8\"][\"finalist_indices\"]) | set(row[\"diverse8\"][\"finalist_indices\"])\n        )\n        assert len(row[\"top8\"][\"finalist_indices\"]) == len(row[\"diverse8\"][\"finalist_indices\"]) == 8\n        assert row[\"top8_overlap\"] == len(\n            set(row[\"top8\"][\"finalist_indices\"]) & set(row[\"diverse8\"][\"finalist_indices\"])\n        )\n        assert all(\n            row[method][\"selected_index\"] in row[method][\"finalist_indices\"]\n            and math.isfinite(row[method][\"score\"])\n            and 0 <= row[method][\"holdout\"] <= 1\n            for method in (\"top8\", \"diverse8\")\n        )\n        if cohort != \"moderate_pilot\":\n            assert row[\"pool\"] == pool and row[\"diversity_weight\"] == weight\n        records.append(dict(cohort=cohort, **row))\n\nsummary = []\nfor cohort, _, pool, weight in cohorts:\n    for dataset in (\"breast\", \"digits\", \"synthetic\"):\n        subset = [row for row in records if row[\"cohort\"] == cohort and row[\"dataset\"] == dataset]\n        deltas = [row[\"diverse8\"][\"holdout\"] - row[\"top8\"][\"holdout\"] for row in subset]\n        summary.append(\n            dict(\n                cohort=cohort,\n                dataset=dataset,\n                pool=pool,\n                diversity_weight=weight,\n                pairs=len(subset),\n                top8_holdout_mean=statistics.mean(row[\"top8\"][\"holdout\"] for row in subset),\n                diverse8_holdout_mean=statistics.mean(row[\"diverse8\"][\"holdout\"] for row in subset),\n                delta_mean=statistics.mean(deltas),\n                worst_delta=min(deltas),\n                wins=sum(delta > 0 for delta in deltas),\n                ties=sum(delta == 0 for delta in deltas),\n                losses=sum(delta < 0 for delta in deltas),\n                overlap_mean=statistics.mean(row[\"top8_overlap\"] for row in subset),\n            )\n        )\n\nsource_paths = [Path(\"sklearn_genetic/genetic_search.py\"), Path(\"sklearn_genetic/algorithms.py\")]\npayload = dict(\n    question=\"Can diversity-aware eight-finalist selection recover low-fold feature quality without more full-CV finalists?\",\n    conclusion=\"mixed_holdout_reject_default_change\",\n    source_commit=subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip(),\n    environment={\n        \"python\": platform.python_version(),\n        **{\n            name: importlib.metadata.version(name)\n            for name in (\"numpy\", \"scikit-learn\", \"scipy\", \"deap\")\n        },\n    },\n    source_sha256={str(path).replace(\"\\\\\", \"/\"): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_paths},\n    summary=summary,\n    raw=records,\n    reproduction_script=(work / \"diverse-finalists-pilot.py\").read_text(encoding=\"utf-8\"),\n    summary_script=Path(__file__).read_text(encoding=\"utf-8\"),\n)\ndestination = Path(\"benchmarks/results/performance-v2/diverse-finalists-pilot.json\")\ndestination.write_text(json.dumps(payload, indent=2), encoding=\"utf-8\")\nprint(json.dumps(summary, indent=2))\n"
}