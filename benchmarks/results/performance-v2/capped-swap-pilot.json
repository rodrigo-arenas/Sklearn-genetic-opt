  "reproduction_script": "import json\nimport platform\nimport random\nimport subprocess\nfrom pathlib import Path\nfrom statistics import mean\nfrom unittest.mock import patch\n\nimport numpy as np\nimport sklearn\nfrom sklearn.base import clone\nfrom sklearn.datasets import load_breast_cancer, load_diabetes, make_classification\nfrom sklearn.linear_model import LogisticRegression, Ridge\nfrom sklearn.metrics import get_scorer\nfrom sklearn.model_selection import KFold, StratifiedKFold, train_test_split\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn_genetic import GAFeatureSelectionCV\nfrom threadpoolctl import threadpool_limits\n\noriginal = GAFeatureSelectionCV.mutate\nrows = []\nwith threadpool_limits(1):\n    for task in (\"breast_cancer\", \"diabetes\", \"sparse_981\", \"sparse_1223\", \"sparse_1997\"):\n        classification = task != \"diabetes\"\n        if task.startswith(\"sparse_\"):\n            X, y = make_classification(n_samples=300, n_features=256, n_informative=4,\n                                       n_redundant=4, random_state=int(task.split(\"_\")[1]))\n        else:\n            X, y = (load_breast_cancer if classification else load_diabetes)(return_X_y=True)\n        model = make_pipeline(StandardScaler(), LogisticRegression() if classification else Ridge())\n        metric = \"balanced_accuracy\" if classification else \"r2\"\n        for split in (17, 31):\n            a,b,c,d = train_test_split(X,y,stratify=y if classification else None,\n                                      random_state=split,test_size=.25)\n            splitter = StratifiedKFold if classification else KFold\n            cv = list(splitter(3,shuffle=True,random_state=split).split(a,c))\n            for seed in (9, 21):\n                for method in (\"default\", \"swap_at_cap\"):\n                    overlap = []\n                    def mutate(estimator, mask):\n                        parent = {i for i,v in enumerate(mask) if v}\n                        if method == \"swap_at_cap\" and len(parent) == estimator.max_features:\n                            remove = random.choice(sorted(parent))\n                            add = random.choice([i for i,v in enumerate(mask) if not v])\n                            mask[remove], mask[add] = 0, 1\n                            result = (mask,)\n                        else:\n                            result = original(estimator,mask)\n                        if len(parent) == estimator.max_features:\n                            overlap.append(sum(mask[i] for i in parent))\n                        return result\n                    with patch.object(GAFeatureSelectionCV,\"mutate\",mutate):\n                        search = GAFeatureSelectionCV(model, max_features=4, population_size=6,\n                            generations=4, scoring=metric, cv=cv, random_state=seed,\n                            n_jobs=1, error_score=\"raise\", verbose=False).fit(a,c)\n                    archive = {}\n                    for mask,score in zip(search.cv_results_[\"features\"],search.cv_results_[\"mean_test_score\"]):\n                        archive.setdefault(tuple(np.flatnonzero(mask).tolist()),score)\n                    assert len(archive) == search.fit_stats_[\"cross_validate_calls\"]\n                    assert len(archive) >= 24\n                    winner,score = max(list(archive.items())[:24],key=lambda item:item[1])\n                    fitted = clone(model).fit(a[:,winner],c)\n                    rows.append(dict(task=task,split=split,seed=seed,method=method,\n                        capped_mutations=len(overlap),retained_columns=overlap,\n                        total_evaluations=len(archive),budget=24,winner=winner,cv=float(score),\n                        holdout=float(get_scorer(metric)(fitted,b[:,winner],d))))\n        for method in (\"default\",\"swap_at_cap\"):\n            subset = [r for r in rows if r[\"task\"]==task and r[\"method\"]==method]\n            retained = [n for r in subset for n in r[\"retained_columns\"]]\n            print(task,method,len(retained),mean(retained) if retained else None,\n                  round(mean(r[\"holdout\"] for r in subset),5),flush=True)\nreport = dict(source_commit=subprocess.check_output([\"git\",\"rev-parse\",\"HEAD\"],text=True).strip(),\n              python=platform.python_version(),numpy=np.__version__,sklearn=sklearn.__version__,\n              reproduction_script=Path(__file__).read_text(encoding=\"utf8\"),rows=rows)\nPath(\"benchmarks/results/performance-v2/capped-swap-pilot.json\").write_text(\n    json.dumps(report,indent=2,allow_nan=False)+\"\\n\",encoding=\"utf8\")\n",
